go.work
go.work.sum

# Go test build outputs (rebuilt by `go test`)
*.test

# Workspace-relative integration test runtime state.
# The canonical path is /tmp/platformd-integration; the in-repo
# tmp/ directory is created when tests are run with the wrong cwd
# and should never be committed.
/tmp/

# vtpm integration test runtime artifacts (regenerated by
# `make integration-test` — qcow2 install image, ISO under test,
# UEFI NVRAM state, swtpm state, boot logs, exported bundles).
/build/integration/vtpm/nvram/
/build/integration/vtpm/server-boot-serial.log
/build/integration/vtpm/server-installed.qcow2
/build/integration/vtpm/server.iso
/build/integration/vtpm/tpm/
/test/integration/vtpm/bundle-*.tar.gz

# pre-quicbaas-migration legacy data dumps; replaced by
# /var/lib/trusted-platform/quicbaas/* at runtime.
/dragondb-dump/

# Working dirs left behind by `platformctl iso create` and
# `make build` if interrupted.
/work/
/work-gw/
/work-compute/
/platform-worker.iso
/trusted-platform.iso
/trusted-alpine-*.iso
/platform-pxeboot.tar
/trusted-data/

# Staged build outputs (regenerated by `make build` / `make *-iso` /
# `make pxeboot-*`). ISOs and binaries are large and must never be
# committed — rebuild on demand instead.
/bin/

# Compiled binaries built by ad-hoc `go build` in the repo root
# (canonical builds live under bin/). Regenerated by the Makefile.
/platformd
/platformctl
/gatewayd
/platform-initrd
/pxeboot
/vbmc
/interface_check
/_logincheck*

# Stale build symlinks from deprecated build-static targets.
/platformctl-static
/platformd-static
/platform-initrd-static

# Next.js / npm build + cache directories (regenerated by the web build).
/web/node_modules/
/web/node_modules/.next-*/
/web/.next/
/web/out/

# The compiled web console. GENERATED, never a build input.
#
# `pkg/webserver/embed/embed_web.go` carries `//go:build platform_web`, so the
# `//go:embed all:dist` directive compiles only when WITH_WEB=1 — and that path
# runs `_web-embed-prepare`, which does `rm -rf $(WEB_EMBED_DIR)/*` and copies a
# fresh `web/out` in before the Go build. The four Docker builders rebuild it
# the same way. So nothing ever READ these files: every consumer regenerated
# them first, and committing them only meant a two-file source change presented
# as ~600 changed files of hash churn (#256).
#
# `.gitkeep` stays tracked so `go:embed all:dist` always has a directory.
/pkg/webserver/embed/dist/*
!/pkg/webserver/embed/dist/.gitkeep
/web/playwright-report/
/web/test-results/
/web/*.log

# Empty bystander files created by accidental `cat >` / `sudo >` invocations.
/cat
/sudo

# Coverage profile output (`go test -coverprofile=<name>.out`; the Makefile's
# coverage targets write to build/coverage/).
*.out

# Playwright run state, written to test-results/ beside the config it ran
# from (the configs under web/ and test/integration/web/ name their own dirs).
/test-results/

# Ad-hoc screen captures left in the repo root.
/capture.jpg

# Build/test log files left in the repo root.
/test.log
/integration-test.log
/sum.log

# bootstrap build ARTIFACTS never enter the module tree (module zip size
# limit); the Dockerfile/scripts/configs in the same directory are source
# and stay tracked.
build/docker/bootstrap/pxeboot
.serena/cache/
/provisioning-client
examples/provisioning-client/provisioning-client
/iso.test
/test.log

# CI security-scan reports (devops.md §8)
trivy-results.sarif
build/gosec-results.sarif
build/gosec-report.txt
build/gosec-stderr.txt

# Deployment-private bootstrap configs. The canonical copies live in
# the private platform-configs repository (deployments/), checked out
# beside this one; site-specific IPs, hostnames, and BMC
# credentials never enter project source control. Local scratch
# copies at these paths stay untracked.
/bootstrap.yaml
/overrides/

# Pinned developer tooling built by the Makefile (make install-golangci-lint).
# Version-stamped, so switching the pin leaves the old build behind rather than
# running it; both are disposable.
/build/tools/

# Python bytecode caches (the U-Boot builder runs mkesl.py on the host)
__pycache__/
*.pyc

# Written under the workspace, as root, by the devcontainer TPM suite's platformd
# (a keystore default relative to its cwd); never source.
/tpm2-keys/

# Test and run logs, and the runtime state tests write beside their package
/build/coverage/
/build/*.log
/integration-test-*.log
/pkg/cli/commands/db/trusted-data/
/pkg/webservice/v1/test/trusted-data/log/
/pkg/webservice/v1/test/trusted-data/quicbaas/
