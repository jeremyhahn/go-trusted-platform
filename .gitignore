go.work
go.work.sum

# Go test build outputs (rebuilt by `go test`)
*.test

# Workspace-relative integration test runtime state.
# The canonical path is /tmp/platformd-integration; the in-repo
# tmp/ directory is created when tests are run with the wrong cwd
# and should never be committed.
/tmp/

# vtpm integration test runtime artifacts (regenerated by
# `make integration-test` — qcow2 install image, ISO under test,
# UEFI NVRAM state, swtpm state, boot logs, exported bundles).
/build/integration/vtpm/nvram/
/build/integration/vtpm/server-boot-serial.log
/build/integration/vtpm/server-installed.qcow2
/build/integration/vtpm/server.iso
/build/integration/vtpm/tpm/
/test/integration/vtpm/bundle-*.tar.gz

# pre-quicbaas-migration legacy data dumps; replaced by
# /var/lib/trusted-platform/quicbaas/* at runtime.
/dragondb-dump/

# Working dirs left behind by `platformctl iso create` and
# `make build` if interrupted.
/work/
/work-gw/
/work-compute/
/platform-worker.iso
/trusted-platform.iso
/trusted-alpine-*.iso
/platform-pxeboot.tar
/trusted-data/

# Staged build outputs (regenerated by `make build` / `make *-iso` /
# `make pxeboot-*`). ISOs and binaries are large and must never be
# committed — rebuild on demand instead.
/bin/

# Compiled binaries built by ad-hoc `go build` in the repo root
# (canonical builds live under bin/). Regenerated by the Makefile.
/platformd
/platformctl
/gatewayd
/platform-initrd
/pxeboot
/vbmc
/interface_check
/_logincheck*

# Stale build symlinks from deprecated build-static targets.
/platformctl-static
/platformd-static
/platform-initrd-static

# Next.js / npm build + cache directories (regenerated by the web build).
/web/node_modules/
/web/node_modules/.next-*/
/web/.next/
/web/out/
/web/playwright-report/
/web/test-results/
/web/*.log

# Empty bystander files created by accidental `cat >` / `sudo >` invocations.
/cat
/sudo

# Coverage profile output.
*.out
coverage.out

# Build/test log files left in the repo root.
/test.log
/integration-test.log
/sum.log

# bootstrap build ARTIFACTS never enter the module tree (module zip size
# limit); the Dockerfile/scripts/configs in the same directory are source
# and stay tracked.
build/docker/bootstrap/alpine-minirootfs.tar.gz
build/docker/bootstrap/dracut-platformd.tar.gz
build/docker/bootstrap/initramfs
build/docker/bootstrap/modloop-lts
build/docker/bootstrap/platformctl
build/docker/bootstrap/platformd
build/docker/bootstrap/platform-initrd
build/docker/bootstrap/pxeboot
build/docker/bootstrap/vmlinuz
.serena/cache/
/provisioning-client
examples/provisioning-client/provisioning-client
/iso.test
/test.log

# CI security-scan reports (devops.md §8)
trivy-results.sarif
build/gosec-results.sarif
build/gosec-report.txt

# Deployment-private bootstrap configs. The canonical copies live in
# the private infra repo (automatethethings/infra/trusted-platform/
# configs/deployments/); site-specific IPs, hostnames, and BMC
# credentials never enter project source control. Local scratch
# copies at these paths stay untracked.
/bootstrap.yaml
/overrides/
