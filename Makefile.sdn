# SDN Integration Tests
# Add these targets to the main Makefile after the integration-test-webservice target (around line 478)

.PHONY: integration-test-sdn
integration-test-sdn: integration-test-sdn-build
	@echo "Running SDN integration tests in docker container..."
	@docker run --rm --privileged \
		--name go-trusted-platform-sdn-test \
		--device /dev/net/tun:/dev/net/tun \
		-v $(PWD):/workspace \
		-w /workspace/test/integration/sdn \
		go-trusted-platform-sdn-test:latest \
		sh -c "go test -v -timeout 10m ./..."

.PHONY: integration-test-sdn-build
integration-test-sdn-build:
	@echo "Building SDN integration test Docker image..."
	@cd test/integration/sdn && \
		docker build -t go-trusted-platform-sdn-test:latest .

.PHONY: integration-test-sdn-shell
integration-test-sdn-shell: integration-test-sdn-build
	@echo "Starting interactive shell in SDN test container..."
	@docker run --rm -it --privileged \
		--name go-trusted-platform-sdn-test-shell \
		--device /dev/net/tun:/dev/net/tun \
		-v $(PWD):/workspace \
		-w /workspace/test/integration/sdn \
		go-trusted-platform-sdn-test:latest \
		/bin/bash

.PHONY: integration-test-sdn-clean
integration-test-sdn-clean:
	@echo "Cleaning SDN integration test artifacts..."
	@docker rmi -f go-trusted-platform-sdn-test:latest 2>/dev/null || true
	@docker volume rm go-trusted-platform-sdn-test_ovs-db 2>/dev/null || true
	@docker volume rm go-trusted-platform-sdn-test_ovs-log 2>/dev/null || true

.PHONY: integration-test-sdn-compose-up
integration-test-sdn-compose-up:
	@echo "Starting SDN integration tests with docker-compose..."
	@cd test/integration/sdn && docker-compose up --build

.PHONY: integration-test-sdn-compose-down
integration-test-sdn-compose-down:
	@echo "Stopping SDN integration test environment..."
	@cd test/integration/sdn && docker-compose down -v
