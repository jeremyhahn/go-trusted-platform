# =============================================================================
# Manual Testing Quick Start
# =============================================================================
#
# 1. Single Node Topology:
#    docker-compose -f single-node.yml up -d
#    docker exec sdn-test-gateway-1 platformctl sdn status
#    docker-compose -f single-node.yml down -v
#
# 2. Three Node Topology:
#    docker-compose -f three-node.yml up -d
#    docker exec sdn-test-gateway-1 platformctl sdn overlay vtep list
#    docker exec sdn-test-gateway-1 platformctl sdn overlay tunnel list
#    docker-compose -f three-node.yml down -v
#
# 3. Multi-Gateway Topology:
#    docker-compose -f multi-gateway.yml up -d
#    docker exec sdn-test-gateway-1 platformctl sdn bgp peer list
#    docker exec sdn-test-gateway-2 platformctl sdn bgp status
#    docker-compose -f multi-gateway.yml down -v
#
# 4. BGP Transit Topology:
#    docker-compose -f bgp-transit.yml up -d
#    docker exec sdn-test-gateway-1 platformctl sdn bgp prefix announce 10.100.0.0/24
#    docker exec sdn-test-mock-isp vtysh -c "show bgp summary"
#    docker-compose -f bgp-transit.yml down -v
#
# =============================================================================
# Debugging Commands
# =============================================================================
#
# View container logs:
#   docker-compose -f topology.yml logs -f [service-name]
#
# Execute command in container:
#   docker exec -it [container-name] bash
#
# Check OVS status:
#   docker exec [container-name] ovs-vsctl show
#
# Check OpenFlow flows:
#   docker exec [container-name] ovs-ofctl dump-flows [bridge-name]
#
# Check VXLAN tunnels:
#   docker exec [container-name] ip link show type vxlan
#
# Check BGP status (FRR):
#   docker exec [container-name] vtysh -c "show bgp summary"
#
# Check EVPN routes:
#   docker exec [container-name] vtysh -c "show bgp l2vpn evpn"
#
# =============================================================================
# Cleanup Commands
# =============================================================================
#
# Stop and remove all:
#   docker-compose -f topology.yml down -v --remove-orphans
#
# Remove all test networks:
#   docker network prune -f
#
# Remove all test containers:
#   docker rm -f $(docker ps -aq --filter "label=topology")
