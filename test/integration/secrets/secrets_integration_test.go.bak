// Package secrets provides integration tests for the DragonDB Secrets services.
// These tests require a real DragonDB instance and are run via:
//
//	make integration-test-secrets
//
// The tests verify end-to-end functionality of secret storage, retrieval,
// rotation, versioning, and policy management operations.
package secrets

import (
	"context"
	"fmt"
	"os"
	"strings"
	"sync"
	"sync/atomic"
	"testing"
	"time"

	"github.com/jeremyhahn/go-dragondb/pkg/service"
	"github.com/jeremyhahn/go-trusted-platform/pkg/logging"
	"github.com/jeremyhahn/go-trusted-platform/pkg/storage/dragondb"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

// skipIfNotIntegration skips the test if the INTEGRATION_TEST env var is not set.
func skipIfNotIntegration(t *testing.T) {
	if os.Getenv("INTEGRATION_TEST") == "" {
		t.Skip("Skipping integration test. Set INTEGRATION_TEST=1 to run.")
	}
}

// newIntegrationClient creates a new DragonDB client for integration testing.
// It returns the client and a cleanup function that must be called with defer.
func newIntegrationClient(t *testing.T) (*dragondb.Client, func()) {
	cfg := dragondb.TestConfig(t)
	logger := logging.DefaultLogger()

	client, err := dragondb.NewClient(cfg, logger)
	require.NoError(t, err)

	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()

	require.NoError(t, client.Start(ctx))

	cleanup := func() {
		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
		defer cancel()
		client.Stop(ctx)
	}

	return client, cleanup
}

// getSecretsService returns the Secrets service from the DragonDB client.
// Skips the test if Secrets service is not available.
func getSecretsService(t *testing.T, client *dragondb.Client) service.SecretsService {
	dbSvc := client.Service()
	require.NotNil(t, dbSvc, "DragonDB service should be available")

	secrets := dbSvc.Secrets()
	if secrets == nil {
		t.Skip("Secrets service not available in DragonDB instance")
	}
	return secrets
}

// =============================================================================
// Secrets Store/Retrieve Integration Tests
// =============================================================================

func TestSecretsStoreRetrieve_Integration(t *testing.T) {
	skipIfNotIntegration(t)

	client, cleanup := newIntegrationClient(t)
	defer cleanup()

	secrets := getSecretsService(t, client)
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()

	t.Run("Store and retrieve secret", func(t *testing.T) {
		secretID := "integration-test-secret-" + time.Now().Format("20060102150405.000000000")
		secretData := []byte("super-secret-password-12345!")

		storeResp, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID:    secretID,
			Name:        secretID,
			Data:        secretData,
			Description: "Integration test secret",
		})
		require.NoError(t, err)
		require.NotNil(t, storeResp)
		assert.Equal(t, secretID, storeResp.SecretID)
		assert.Equal(t, uint64(1), storeResp.Version)

		getResp, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		require.NoError(t, err)
		require.NotNil(t, getResp)
		assert.Equal(t, secretData, getResp.Data)
		assert.Equal(t, secretID, getResp.SecretID)
	})

	t.Run("Store secret with metadata", func(t *testing.T) {
		secretID := "integration-test-metadata-" + time.Now().Format("20060102150405.000000000")
		secretData := []byte("secret-with-metadata")
		metadata := map[string]string{
			"environment": "integration-test",
			"owner":       "test-user",
			"purpose":     "testing",
		}

		storeResp, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID:    secretID,
			Name:        secretID,
			Data:        secretData,
			Description: "Secret with metadata",
			Metadata:    metadata,
		})
		require.NoError(t, err)
		require.NotNil(t, storeResp)

		getResp, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		require.NoError(t, err)
		assert.Equal(t, secretData, getResp.Data)
	})

	t.Run("Store binary secret data", func(t *testing.T) {
		secretID := "integration-test-binary-" + time.Now().Format("20060102150405.000000000")
		binaryData := make([]byte, 256)
		for i := range binaryData {
			binaryData[i] = byte(i)
		}

		storeResp, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID:    secretID,
			Name:        secretID,
			Data:        binaryData,
			Description: "Binary secret data",
		})
		require.NoError(t, err)
		require.NotNil(t, storeResp)

		getResp, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		require.NoError(t, err)
		assert.Equal(t, binaryData, getResp.Data)
	})

	t.Run("Store large secret", func(t *testing.T) {
		secretID := "integration-test-large-" + time.Now().Format("20060102150405.000000000")
		largeData := make([]byte, 64*1024) // 64KB
		for i := range largeData {
			largeData[i] = byte(i % 256)
		}

		storeResp, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID:    secretID,
			Name:        secretID,
			Data:        largeData,
			Description: "Large secret data",
		})
		require.NoError(t, err)
		require.NotNil(t, storeResp)

		getResp, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		require.NoError(t, err)
		assert.Equal(t, largeData, getResp.Data)
	})

	t.Run("Store maximum size secret", func(t *testing.T) {
		secretID := "integration-test-max-size-" + time.Now().Format("20060102150405.000000000")
		// Test with 1MB secret - typical maximum for secret stores
		maxData := make([]byte, 1024*1024)
		for i := range maxData {
			maxData[i] = byte(i % 256)
		}

		storeResp, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID:    secretID,
			Name:        secretID,
			Data:        maxData,
			Description: "Maximum size secret data",
		})
		require.NoError(t, err, "storing maximum size secret should succeed")
		require.NotNil(t, storeResp)
		assert.Equal(t, secretID, storeResp.SecretID)

		getResp, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		require.NoError(t, err)
		assert.Equal(t, maxData, getResp.Data, "retrieved data should match stored maximum size data")
	})

	t.Run("Store secret with special characters in ID", func(t *testing.T) {
		timestamp := time.Now().Format("20060102150405.000000000")
		// Test various special characters that should be valid in secret IDs
		specialIDs := []struct {
			name     string
			secretID string
		}{
			{"hyphen", "integration-special-hyphen-" + timestamp},
			{"underscore", "integration_special_underscore_" + timestamp},
			{"dot", "integration.special.dot." + timestamp},
			{"slash", "integration/special/slash/" + timestamp},
			{"mixed", "integration-test_special.chars/mixed-" + timestamp},
		}

		for _, tc := range specialIDs {
			t.Run(tc.name, func(t *testing.T) {
				secretData := []byte("special-char-secret-data")

				storeResp, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
					SecretID:    tc.secretID,
					Name:        tc.secretID,
					Data:        secretData,
					Description: "Secret with special characters in ID",
				})
				require.NoError(t, err, "storing secret with %s should succeed", tc.name)
				require.NotNil(t, storeResp)
				assert.Equal(t, tc.secretID, storeResp.SecretID)

				getResp, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
					SecretID: tc.secretID,
				})
				require.NoError(t, err, "retrieving secret with %s should succeed", tc.name)
				assert.Equal(t, secretData, getResp.Data)
			})
		}
	})
}

// =============================================================================
// Secrets List with Pagination Integration Tests
// =============================================================================

func TestSecretsList_Integration(t *testing.T) {
	skipIfNotIntegration(t)

	client, cleanup := newIntegrationClient(t)
	defer cleanup()

	secrets := getSecretsService(t, client)
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()

	t.Run("List secrets", func(t *testing.T) {
		prefix := "integration-list-" + time.Now().Format("20060102150405.000000000")
		secretCount := 5

		for i := 0; i < secretCount; i++ {
			secretID := fmt.Sprintf("%s-%d", prefix, i)
			_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
				SecretID:    secretID,
				Name:        secretID,
				Data:        []byte(fmt.Sprintf("secret-data-%d", i)),
				Description: fmt.Sprintf("List test secret %d", i),
			})
			require.NoError(t, err)
		}

		listResp, err := secrets.ListSecrets(ctx, &service.ListSecretsRequest{
			Limit: 100,
		})
		require.NoError(t, err)
		require.NotNil(t, listResp)
		assert.GreaterOrEqual(t, len(listResp.Secrets), secretCount)
	})

	t.Run("List secrets with pagination", func(t *testing.T) {
		prefix := "integration-paginate-" + time.Now().Format("20060102150405.000000000")
		secretCount := 10

		for i := 0; i < secretCount; i++ {
			secretID := fmt.Sprintf("%s-%d", prefix, i)
			_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
				SecretID: secretID,
				Name:     secretID,
				Data:     []byte(fmt.Sprintf("paginated-secret-%d", i)),
			})
			require.NoError(t, err)
		}

		// First page
		listResp1, err := secrets.ListSecrets(ctx, &service.ListSecretsRequest{
			Limit: 3,
		})
		require.NoError(t, err)
		require.NotNil(t, listResp1)
		assert.GreaterOrEqual(t, len(listResp1.Secrets), 1)

		if listResp1.HasMore && listResp1.NextCursor != "" {
			// Second page
			listResp2, err := secrets.ListSecrets(ctx, &service.ListSecretsRequest{
				Limit:  3,
				Cursor: listResp1.NextCursor,
			})
			require.NoError(t, err)
			require.NotNil(t, listResp2)
			assert.GreaterOrEqual(t, len(listResp2.Secrets), 1)
		}
	})
}

// =============================================================================
// Secrets Delete Integration Tests
// =============================================================================

func TestSecretsDelete_Integration(t *testing.T) {
	skipIfNotIntegration(t)

	client, cleanup := newIntegrationClient(t)
	defer cleanup()

	secrets := getSecretsService(t, client)
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()

	t.Run("Soft delete secret", func(t *testing.T) {
		secretID := "integration-soft-delete-" + time.Now().Format("20060102150405.000000000")
		secretData := []byte("to-be-soft-deleted")

		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     secretData,
		})
		require.NoError(t, err)

		deleteResp, err := secrets.DeleteSecret(ctx, &service.DeleteSecretRequest{
			SecretID:          secretID,
			PermanentlyDelete: false,
		})
		require.NoError(t, err)
		require.NotNil(t, deleteResp)
		assert.True(t, deleteResp.Deleted)
	})

	t.Run("Permanent delete secret", func(t *testing.T) {
		secretID := "integration-perm-delete-" + time.Now().Format("20060102150405.000000000")
		secretData := []byte("to-be-permanently-deleted")

		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     secretData,
		})
		require.NoError(t, err)

		deleteResp, err := secrets.DeleteSecret(ctx, &service.DeleteSecretRequest{
			SecretID:          secretID,
			PermanentlyDelete: true,
		})
		require.NoError(t, err)
		require.NotNil(t, deleteResp)
		assert.True(t, deleteResp.Deleted)

		// Verify permanent deletion
		_, err = secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		require.Error(t, err, "permanently deleted secret should not be retrievable")
	})

	t.Run("Delete nonexistent secret returns error", func(t *testing.T) {
		_, err := secrets.DeleteSecret(ctx, &service.DeleteSecretRequest{
			SecretID:          "nonexistent-secret-" + time.Now().Format("20060102150405.000000000"),
			PermanentlyDelete: true,
		})
		require.Error(t, err)
	})
}

// =============================================================================
// Secrets Rotation with Version Management Integration Tests
// =============================================================================

func TestSecretsRotation_Integration(t *testing.T) {
	skipIfNotIntegration(t)

	client, cleanup := newIntegrationClient(t)
	defer cleanup()

	secrets := getSecretsService(t, client)
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()

	t.Run("Rotate secret creates new version", func(t *testing.T) {
		secretID := "integration-rotate-" + time.Now().Format("20060102150405.000000000")
		originalData := []byte("original-secret-value")
		newData := []byte("rotated-secret-value")

		storeResp, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     originalData,
		})
		require.NoError(t, err)
		originalVersion := storeResp.Version

		rotateResp, err := secrets.RotateSecret(ctx, &service.RotateSecretRequest{
			SecretID: secretID,
			NewData:  newData,
		})
		require.NoError(t, err)
		require.NotNil(t, rotateResp)
		assert.Equal(t, originalVersion, rotateResp.OldVersion)
		assert.Greater(t, rotateResp.NewVersion, rotateResp.OldVersion)

		// Verify new value is returned
		getResp, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		require.NoError(t, err)
		assert.Equal(t, newData, getResp.Data)
	})

	t.Run("Multiple rotations increment version", func(t *testing.T) {
		secretID := "integration-multi-rotate-" + time.Now().Format("20060102150405.000000000")

		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("version-1"),
		})
		require.NoError(t, err)

		for i := 2; i <= 5; i++ {
			rotateResp, err := secrets.RotateSecret(ctx, &service.RotateSecretRequest{
				SecretID: secretID,
				NewData:  []byte(fmt.Sprintf("version-%d", i)),
			})
			require.NoError(t, err)
			assert.Equal(t, uint64(i), rotateResp.NewVersion)
		}

		getResp, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		require.NoError(t, err)
		assert.Equal(t, []byte("version-5"), getResp.Data)
	})

	t.Run("Rotate nonexistent secret returns error", func(t *testing.T) {
		_, err := secrets.RotateSecret(ctx, &service.RotateSecretRequest{
			SecretID: "nonexistent-rotate-" + time.Now().Format("20060102150405.000000000"),
			NewData:  []byte("new-value"),
		})
		require.Error(t, err)
	})
}

// =============================================================================
// Get Specific Secret Version Integration Tests
// =============================================================================

func TestSecretsGetVersion_Integration(t *testing.T) {
	skipIfNotIntegration(t)

	client, cleanup := newIntegrationClient(t)
	defer cleanup()

	secrets := getSecretsService(t, client)
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()

	t.Run("Get specific version of secret", func(t *testing.T) {
		secretID := "integration-get-version-" + time.Now().Format("20060102150405.000000000")
		v1Data := []byte("version-1-data")
		v2Data := []byte("version-2-data")
		v3Data := []byte("version-3-data")

		// Create version 1
		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     v1Data,
		})
		require.NoError(t, err)

		// Rotate to version 2
		_, err = secrets.RotateSecret(ctx, &service.RotateSecretRequest{
			SecretID: secretID,
			NewData:  v2Data,
		})
		require.NoError(t, err)

		// Rotate to version 3
		_, err = secrets.RotateSecret(ctx, &service.RotateSecretRequest{
			SecretID: secretID,
			NewData:  v3Data,
		})
		require.NoError(t, err)

		// Get version 1 - response contains Version.Data
		v1Resp, err := secrets.GetSecretVersion(ctx, &service.GetSecretVersionRequest{
			SecretID: secretID,
			Version:  1,
		})
		require.NoError(t, err)
		require.NotNil(t, v1Resp.Version)
		assert.Equal(t, v1Data, v1Resp.Version.Data)

		// Get version 2
		v2Resp, err := secrets.GetSecretVersion(ctx, &service.GetSecretVersionRequest{
			SecretID: secretID,
			Version:  2,
		})
		require.NoError(t, err)
		require.NotNil(t, v2Resp.Version)
		assert.Equal(t, v2Data, v2Resp.Version.Data)

		// Get version 3
		v3Resp, err := secrets.GetSecretVersion(ctx, &service.GetSecretVersionRequest{
			SecretID: secretID,
			Version:  3,
		})
		require.NoError(t, err)
		require.NotNil(t, v3Resp.Version)
		assert.Equal(t, v3Data, v3Resp.Version.Data)
	})

	t.Run("Get nonexistent version returns error", func(t *testing.T) {
		secretID := "integration-get-bad-version-" + time.Now().Format("20060102150405.000000000")

		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("test-data"),
		})
		require.NoError(t, err)

		_, err = secrets.GetSecretVersion(ctx, &service.GetSecretVersionRequest{
			SecretID: secretID,
			Version:  999,
		})
		require.Error(t, err)
	})
}

// =============================================================================
// List Secret Versions Integration Tests
// =============================================================================

func TestSecretsListVersions_Integration(t *testing.T) {
	skipIfNotIntegration(t)

	client, cleanup := newIntegrationClient(t)
	defer cleanup()

	secrets := getSecretsService(t, client)
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()

	t.Run("List all versions of a secret", func(t *testing.T) {
		secretID := "integration-list-versions-" + time.Now().Format("20060102150405.000000000")
		versionCount := 5

		// Create initial version
		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("version-1"),
		})
		require.NoError(t, err)

		// Create additional versions
		for i := 2; i <= versionCount; i++ {
			_, err = secrets.RotateSecret(ctx, &service.RotateSecretRequest{
				SecretID: secretID,
				NewData:  []byte(fmt.Sprintf("version-%d", i)),
			})
			require.NoError(t, err)
		}

		// List versions
		listResp, err := secrets.ListSecretVersions(ctx, &service.ListSecretVersionsRequest{
			SecretID: secretID,
			Limit:    100,
		})
		require.NoError(t, err)
		require.NotNil(t, listResp)
		assert.Equal(t, versionCount, len(listResp.Versions))
	})

	t.Run("List versions with pagination", func(t *testing.T) {
		secretID := "integration-versions-paginate-" + time.Now().Format("20060102150405.000000000")
		versionCount := 10

		// Create initial version
		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("version-1"),
		})
		require.NoError(t, err)

		// Create additional versions
		for i := 2; i <= versionCount; i++ {
			_, err = secrets.RotateSecret(ctx, &service.RotateSecretRequest{
				SecretID: secretID,
				NewData:  []byte(fmt.Sprintf("version-%d", i)),
			})
			require.NoError(t, err)
		}

		// First page
		listResp1, err := secrets.ListSecretVersions(ctx, &service.ListSecretVersionsRequest{
			SecretID: secretID,
			Limit:    3,
		})
		require.NoError(t, err)
		require.NotNil(t, listResp1)
		assert.LessOrEqual(t, len(listResp1.Versions), 3)

		if listResp1.HasMore && listResp1.NextCursor != "" {
			// Second page
			listResp2, err := secrets.ListSecretVersions(ctx, &service.ListSecretVersionsRequest{
				SecretID: secretID,
				Limit:    3,
				Cursor:   listResp1.NextCursor,
			})
			require.NoError(t, err)
			require.NotNil(t, listResp2)
		}
	})
}

// =============================================================================
// Rollback to Previous Version Integration Tests
// =============================================================================

func TestSecretsRollback_Integration(t *testing.T) {
	skipIfNotIntegration(t)

	client, cleanup := newIntegrationClient(t)
	defer cleanup()

	secrets := getSecretsService(t, client)
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()

	t.Run("Rollback to previous version", func(t *testing.T) {
		secretID := "integration-rollback-" + time.Now().Format("20060102150405.000000000")
		v1Data := []byte("version-1-data")
		v2Data := []byte("version-2-data")
		v3Data := []byte("version-3-data")

		// Create version 1
		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     v1Data,
		})
		require.NoError(t, err)

		// Rotate to version 2
		_, err = secrets.RotateSecret(ctx, &service.RotateSecretRequest{
			SecretID: secretID,
			NewData:  v2Data,
		})
		require.NoError(t, err)

		// Rotate to version 3
		_, err = secrets.RotateSecret(ctx, &service.RotateSecretRequest{
			SecretID: secretID,
			NewData:  v3Data,
		})
		require.NoError(t, err)

		// Rollback to version 1
		rollbackResp, err := secrets.RollbackSecret(ctx, &service.RollbackSecretRequest{
			SecretID:      secretID,
			TargetVersion: 1,
		})
		require.NoError(t, err)
		require.NotNil(t, rollbackResp)
		assert.Equal(t, uint64(4), rollbackResp.NewVersion) // Creates new version 4

		// Verify current value is now v1 data
		getResp, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		require.NoError(t, err)
		assert.Equal(t, v1Data, getResp.Data)
	})

	t.Run("Rollback to nonexistent version returns error", func(t *testing.T) {
		secretID := "integration-rollback-bad-" + time.Now().Format("20060102150405.000000000")

		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("test-data"),
		})
		require.NoError(t, err)

		_, err = secrets.RollbackSecret(ctx, &service.RollbackSecretRequest{
			SecretID:      secretID,
			TargetVersion: 999,
		})
		require.Error(t, err)
	})

	t.Run("Rollback nonexistent secret returns error", func(t *testing.T) {
		_, err := secrets.RollbackSecret(ctx, &service.RollbackSecretRequest{
			SecretID:      "nonexistent-rollback-" + time.Now().Format("20060102150405.000000000"),
			TargetVersion: 1,
		})
		require.Error(t, err)
	})
}

// =============================================================================
// Rotation Policy Get/Set Integration Tests
// =============================================================================

func TestSecretsRotationPolicy_Integration(t *testing.T) {
	skipIfNotIntegration(t)

	client, cleanup := newIntegrationClient(t)
	defer cleanup()

	secrets := getSecretsService(t, client)
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()

	t.Run("Set and get rotation policy", func(t *testing.T) {
		secretID := "integration-policy-" + time.Now().Format("20060102150405.000000000")

		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("policy-test-secret"),
		})
		require.NoError(t, err)

		// Set rotation policy - uses time.Duration for Interval
		setResp, err := secrets.SetRotationPolicy(ctx, &service.SetRotationPolicyRequest{
			SecretID: secretID,
			Policy: &service.SecretRotationPolicy{
				Enabled:        true,
				Interval:       24 * time.Hour,
				RetainVersions: 10,
			},
		})
		require.NoError(t, err)
		require.NotNil(t, setResp)
		assert.True(t, setResp.Policy.Enabled)
		assert.Equal(t, 24*time.Hour, setResp.Policy.Interval)

		// Get rotation policy
		getResp, err := secrets.GetRotationPolicy(ctx, &service.GetRotationPolicyRequest{
			SecretID: secretID,
		})
		require.NoError(t, err)
		require.NotNil(t, getResp)
		assert.True(t, getResp.Policy.Enabled)
		assert.Equal(t, 24*time.Hour, getResp.Policy.Interval)
		assert.Equal(t, 10, getResp.Policy.RetainVersions)
	})

	t.Run("Disable rotation policy", func(t *testing.T) {
		secretID := "integration-policy-disable-" + time.Now().Format("20060102150405.000000000")

		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("disable-policy-test"),
		})
		require.NoError(t, err)

		// Enable policy
		_, err = secrets.SetRotationPolicy(ctx, &service.SetRotationPolicyRequest{
			SecretID: secretID,
			Policy: &service.SecretRotationPolicy{
				Enabled:        true,
				Interval:       1 * time.Hour,
				RetainVersions: 5,
			},
		})
		require.NoError(t, err)

		// Disable policy
		setResp, err := secrets.SetRotationPolicy(ctx, &service.SetRotationPolicyRequest{
			SecretID: secretID,
			Policy: &service.SecretRotationPolicy{
				Enabled: false,
			},
		})
		require.NoError(t, err)
		assert.False(t, setResp.Policy.Enabled)
	})

	t.Run("Get policy for nonexistent secret returns error", func(t *testing.T) {
		_, err := secrets.GetRotationPolicy(ctx, &service.GetRotationPolicyRequest{
			SecretID: "nonexistent-policy-" + time.Now().Format("20060102150405.000000000"),
		})
		require.Error(t, err)
	})

	t.Run("Update existing rotation policy with different values", func(t *testing.T) {
		secretID := "integration-policy-update-" + time.Now().Format("20060102150405.000000000")

		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("update-policy-test"),
		})
		require.NoError(t, err)

		// Set initial policy
		initialResp, err := secrets.SetRotationPolicy(ctx, &service.SetRotationPolicyRequest{
			SecretID: secretID,
			Policy: &service.SecretRotationPolicy{
				Enabled:        true,
				Interval:       24 * time.Hour,
				RetainVersions: 5,
			},
		})
		require.NoError(t, err)
		require.NotNil(t, initialResp)
		assert.True(t, initialResp.Policy.Enabled)
		assert.Equal(t, 24*time.Hour, initialResp.Policy.Interval)
		assert.Equal(t, 5, initialResp.Policy.RetainVersions)

		// Update to different values
		updateResp, err := secrets.SetRotationPolicy(ctx, &service.SetRotationPolicyRequest{
			SecretID: secretID,
			Policy: &service.SecretRotationPolicy{
				Enabled:        true,
				Interval:       12 * time.Hour,
				RetainVersions: 10,
			},
		})
		require.NoError(t, err)
		require.NotNil(t, updateResp)
		assert.True(t, updateResp.Policy.Enabled)
		assert.Equal(t, 12*time.Hour, updateResp.Policy.Interval)
		assert.Equal(t, 10, updateResp.Policy.RetainVersions)

		// Verify the update persisted
		getResp, err := secrets.GetRotationPolicy(ctx, &service.GetRotationPolicyRequest{
			SecretID: secretID,
		})
		require.NoError(t, err)
		require.NotNil(t, getResp)
		assert.True(t, getResp.Policy.Enabled)
		assert.Equal(t, 12*time.Hour, getResp.Policy.Interval, "interval should be updated to 12 hours")
		assert.Equal(t, 10, getResp.Policy.RetainVersions, "retain versions should be updated to 10")
	})
}

// =============================================================================
// Secrets by Prefix Integration Tests
// =============================================================================

func TestSecretsByPrefix_Integration(t *testing.T) {
	skipIfNotIntegration(t)

	client, cleanup := newIntegrationClient(t)
	defer cleanup()

	secrets := getSecretsService(t, client)
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()

	t.Run("Get secrets by prefix", func(t *testing.T) {
		prefix := "integration/prefix-test/" + time.Now().Format("20060102150405.000000000") + "/"
		secretCount := 5

		for i := 0; i < secretCount; i++ {
			secretID := fmt.Sprintf("%ssecret-%d", prefix, i)
			_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
				SecretID: secretID,
				Name:     secretID,
				Data:     []byte(fmt.Sprintf("prefix-data-%d", i)),
			})
			require.NoError(t, err)
		}

		// Get by prefix - response.Secrets is map[string]map[string][]byte
		prefixResp, err := secrets.GetSecretsByPrefix(ctx, &service.GetSecretsByPrefixRequest{
			Prefix:      prefix,
			IncludeData: true,
			Limit:       100,
		})
		require.NoError(t, err)
		require.NotNil(t, prefixResp)
		assert.GreaterOrEqual(t, len(prefixResp.Secrets), secretCount)
	})

	t.Run("Get secrets by prefix without data", func(t *testing.T) {
		prefix := "integration/prefix-nodata/" + time.Now().Format("20060102150405.000000000") + "/"

		for i := 0; i < 3; i++ {
			secretID := fmt.Sprintf("%ssecret-%d", prefix, i)
			_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
				SecretID: secretID,
				Name:     secretID,
				Data:     []byte(fmt.Sprintf("no-data-test-%d", i)),
			})
			require.NoError(t, err)
		}

		prefixResp, err := secrets.GetSecretsByPrefix(ctx, &service.GetSecretsByPrefixRequest{
			Prefix:      prefix,
			IncludeData: false,
			Limit:       100,
		})
		require.NoError(t, err)
		require.NotNil(t, prefixResp)
	})

	t.Run("Empty prefix returns empty results or error", func(t *testing.T) {
		resp, err := secrets.GetSecretsByPrefix(ctx, &service.GetSecretsByPrefixRequest{
			Prefix:      "",
			IncludeData: false,
			Limit:       100,
		})
		// Either returns error or empty/all results depending on implementation
		// The key assertion is that the system handles empty prefix gracefully
		if err != nil {
			// Error is acceptable - implementation may reject empty prefix
			assert.Error(t, err, "empty prefix should return an error if implementation rejects it")
		} else {
			// Empty results or all secrets is acceptable
			require.NotNil(t, resp, "response should not be nil when no error")
		}
	})
}

// =============================================================================
// Watch Secrets (Streaming) Integration Tests
// =============================================================================

func TestSecretsWatch_Integration(t *testing.T) {
	skipIfNotIntegration(t)

	client, cleanup := newIntegrationClient(t)
	defer cleanup()

	secrets := getSecretsService(t, client)

	t.Run("Watch secrets by prefix receives create events", func(t *testing.T) {
		prefix := "integration/watch-create/" + time.Now().Format("20060102150405.000000000") + "/"

		// Create a cancellable context with timeout for watch test
		ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
		defer cancel()

		// Start watching - returns a channel
		var changes []*service.SecretChange
		var watchErr error
		var changeMu sync.Mutex
		watchReady := make(chan struct{})
		watchDone := make(chan struct{})

		go func() {
			defer close(watchDone)
			changeChan, err := secrets.WatchSecretsByPrefix(ctx, &service.WatchSecretsRequest{
				Prefix:       prefix,
				StartVersion: 0,
			})
			if err != nil {
				watchErr = err
				close(watchReady)
				return
			}

			close(watchReady)

			// Read from channel until closed or context done
			for change := range changeChan {
				changeMu.Lock()
				changes = append(changes, change)
				changeMu.Unlock()
			}
		}()

		// Wait for watch to be ready
		select {
		case <-watchReady:
			// Continue
		case <-time.After(2 * time.Second):
			t.Fatal("timeout waiting for watch to be ready")
		}

		if watchErr != nil {
			t.Fatalf("watch setup failed: %v", watchErr)
		}

		// Give the watch stream time to fully establish
		time.Sleep(200 * time.Millisecond)

		// Create secrets and track their IDs
		createdSecrets := make([]string, 3)
		for i := 0; i < 3; i++ {
			secretID := fmt.Sprintf("%ssecret-%d", prefix, i)
			createdSecrets[i] = secretID
			_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
				SecretID: secretID,
				Name:     secretID,
				Data:     []byte(fmt.Sprintf("watch-data-%d", i)),
			})
			require.NoError(t, err, "storing secret %s should succeed", secretID)
		}

		// Wait for changes to propagate
		time.Sleep(500 * time.Millisecond)

		// Cancel and wait for watch to complete
		cancel()
		<-watchDone

		// Verify we received change events
		changeMu.Lock()
		receivedChanges := make([]*service.SecretChange, len(changes))
		copy(receivedChanges, changes)
		changeMu.Unlock()

		assert.GreaterOrEqual(t, len(receivedChanges), 1,
			"should receive at least one change event for created secrets")

		// Verify at least one create event was received
		var foundCreate bool
		for _, change := range receivedChanges {
			if change.ChangeType == service.SecretChangeCreated {
				foundCreate = true
				// Verify the change is for one of our created secrets
				var matchesCreated bool
				for _, createdID := range createdSecrets {
					if strings.HasPrefix(change.Path, prefix) || change.Path == createdID {
						matchesCreated = true
						break
					}
				}
				assert.True(t, matchesCreated,
					"create event should be for a secret we created, got: %s", change.Path)
			}
		}
		assert.True(t, foundCreate, "should receive at least one create change event")
	})

	t.Run("Watch secrets by prefix receives update events", func(t *testing.T) {
		prefix := "integration/watch-update/" + time.Now().Format("20060102150405.000000000") + "/"
		secretID := prefix + "update-test-secret"

		// Create initial secret before starting watch
		storeCtx, storeCancel := context.WithTimeout(context.Background(), 10*time.Second)
		_, err := secrets.StoreSecret(storeCtx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("initial-value"),
		})
		storeCancel()
		require.NoError(t, err)

		// Create a cancellable context for watch
		ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
		defer cancel()

		var changes []*service.SecretChange
		var changeMu sync.Mutex
		watchReady := make(chan struct{})
		watchDone := make(chan struct{})

		go func() {
			defer close(watchDone)
			changeChan, err := secrets.WatchSecretsByPrefix(ctx, &service.WatchSecretsRequest{
				Prefix:       prefix,
				StartVersion: 0,
			})
			if err != nil {
				close(watchReady)
				return
			}

			close(watchReady)

			for change := range changeChan {
				changeMu.Lock()
				changes = append(changes, change)
				changeMu.Unlock()
			}
		}()

		// Wait for watch to be ready
		select {
		case <-watchReady:
		case <-time.After(2 * time.Second):
			t.Fatal("timeout waiting for watch to be ready")
		}

		time.Sleep(200 * time.Millisecond)

		// Rotate the secret to trigger update event
		_, err = secrets.RotateSecret(ctx, &service.RotateSecretRequest{
			SecretID: secretID,
			NewData:  []byte("updated-value"),
		})
		require.NoError(t, err)

		// Wait for changes to propagate
		time.Sleep(500 * time.Millisecond)

		cancel()
		<-watchDone

		changeMu.Lock()
		receivedChanges := make([]*service.SecretChange, len(changes))
		copy(receivedChanges, changes)
		changeMu.Unlock()

		// Look for update event
		var foundUpdate bool
		for _, change := range receivedChanges {
			if change.ChangeType == service.SecretChangeUpdated && change.Path == secretID {
				foundUpdate = true
				assert.Equal(t, secretID, change.Path)
				break
			}
		}
		assert.True(t, foundUpdate, "should receive update change event for rotated secret")
	})

	t.Run("Watch secrets by prefix receives delete events", func(t *testing.T) {
		prefix := "integration/watch-delete/" + time.Now().Format("20060102150405.000000000") + "/"
		secretID := prefix + "delete-test-secret"

		// Create secret before starting watch
		storeCtx, storeCancel := context.WithTimeout(context.Background(), 10*time.Second)
		_, err := secrets.StoreSecret(storeCtx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("to-be-deleted"),
		})
		storeCancel()
		require.NoError(t, err)

		// Create a cancellable context for watch
		ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
		defer cancel()

		var changes []*service.SecretChange
		var changeMu sync.Mutex
		watchReady := make(chan struct{})
		watchDone := make(chan struct{})

		go func() {
			defer close(watchDone)
			changeChan, err := secrets.WatchSecretsByPrefix(ctx, &service.WatchSecretsRequest{
				Prefix:       prefix,
				StartVersion: 0,
			})
			if err != nil {
				close(watchReady)
				return
			}

			close(watchReady)

			for change := range changeChan {
				changeMu.Lock()
				changes = append(changes, change)
				changeMu.Unlock()
			}
		}()

		// Wait for watch to be ready
		select {
		case <-watchReady:
		case <-time.After(2 * time.Second):
			t.Fatal("timeout waiting for watch to be ready")
		}

		time.Sleep(200 * time.Millisecond)

		// Delete the secret to trigger delete event
		_, err = secrets.DeleteSecret(ctx, &service.DeleteSecretRequest{
			SecretID:          secretID,
			PermanentlyDelete: true,
		})
		require.NoError(t, err)

		// Wait for changes to propagate
		time.Sleep(500 * time.Millisecond)

		cancel()
		<-watchDone

		changeMu.Lock()
		receivedChanges := make([]*service.SecretChange, len(changes))
		copy(receivedChanges, changes)
		changeMu.Unlock()

		// Look for delete event
		var foundDelete bool
		for _, change := range receivedChanges {
			if change.ChangeType == service.SecretChangeDeleted && change.Path == secretID {
				foundDelete = true
				assert.Equal(t, secretID, change.Path)
				break
			}
		}
		assert.True(t, foundDelete, "should receive delete change event for deleted secret")
	})
}

// =============================================================================
// Secret Status Management Integration Tests
// =============================================================================

func TestSecretsStatus_Integration(t *testing.T) {
	skipIfNotIntegration(t)

	client, cleanup := newIntegrationClient(t)
	defer cleanup()

	secrets := getSecretsService(t, client)
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()

	t.Run("Disable and enable secret", func(t *testing.T) {
		secretID := "integration-status-" + time.Now().Format("20060102150405.000000000")

		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("status-test-secret"),
		})
		require.NoError(t, err)

		// Disable secret - response has NewStatus field
		disableResp, err := secrets.UpdateSecretStatus(ctx, &service.UpdateSecretStatusRequest{
			SecretID: secretID,
			Status:   service.SecretStatusDisabled,
		})
		require.NoError(t, err)
		require.NotNil(t, disableResp)
		assert.Equal(t, service.SecretStatusDisabled, disableResp.NewStatus)

		// Enable secret
		enableResp, err := secrets.UpdateSecretStatus(ctx, &service.UpdateSecretStatusRequest{
			SecretID: secretID,
			Status:   service.SecretStatusEnabled,
		})
		require.NoError(t, err)
		require.NotNil(t, enableResp)
		assert.Equal(t, service.SecretStatusEnabled, enableResp.NewStatus)
	})

	t.Run("Cannot retrieve disabled secret", func(t *testing.T) {
		secretID := "integration-status-disabled-" + time.Now().Format("20060102150405.000000000")
		secretData := []byte("disabled-secret")

		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     secretData,
		})
		require.NoError(t, err)

		// Disable secret
		_, err = secrets.UpdateSecretStatus(ctx, &service.UpdateSecretStatusRequest{
			SecretID: secretID,
			Status:   service.SecretStatusDisabled,
		})
		require.NoError(t, err)

		// Attempt to retrieve - should fail or return error
		_, err = secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		// Disabled secrets should not be retrievable
		require.Error(t, err, "retrieving disabled secret should return an error")
	})

	t.Run("Re-enable disabled secret allows retrieval", func(t *testing.T) {
		secretID := "integration-status-reenable-" + time.Now().Format("20060102150405.000000000")
		secretData := []byte("reenable-test-secret")

		// Store the secret
		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     secretData,
		})
		require.NoError(t, err)

		// Verify initial retrieval works
		getResp, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		require.NoError(t, err)
		assert.Equal(t, secretData, getResp.Data)

		// Disable secret
		disableResp, err := secrets.UpdateSecretStatus(ctx, &service.UpdateSecretStatusRequest{
			SecretID: secretID,
			Status:   service.SecretStatusDisabled,
		})
		require.NoError(t, err)
		assert.Equal(t, service.SecretStatusDisabled, disableResp.NewStatus)

		// Verify retrieval fails when disabled
		_, err = secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		require.Error(t, err, "retrieving disabled secret should fail")

		// Re-enable secret
		enableResp, err := secrets.UpdateSecretStatus(ctx, &service.UpdateSecretStatusRequest{
			SecretID: secretID,
			Status:   service.SecretStatusEnabled,
		})
		require.NoError(t, err)
		assert.Equal(t, service.SecretStatusEnabled, enableResp.NewStatus)

		// Verify retrieval works again after re-enabling
		getResp, err = secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		require.NoError(t, err, "retrieving re-enabled secret should succeed")
		assert.Equal(t, secretData, getResp.Data, "re-enabled secret should return original data")
	})

	t.Run("Update status of nonexistent secret returns error", func(t *testing.T) {
		_, err := secrets.UpdateSecretStatus(ctx, &service.UpdateSecretStatusRequest{
			SecretID: "nonexistent-status-" + time.Now().Format("20060102150405.000000000"),
			Status:   service.SecretStatusDisabled,
		})
		require.Error(t, err)
	})
}

// =============================================================================
// Concurrent Secret Operations Integration Tests
// =============================================================================

func TestSecretsConcurrentOperations_Integration(t *testing.T) {
	skipIfNotIntegration(t)

	client, cleanup := newIntegrationClient(t)
	defer cleanup()

	secrets := getSecretsService(t, client)
	ctx, cancel := context.WithTimeout(context.Background(), 120*time.Second)
	defer cancel()

	t.Run("Concurrent secret storage", func(t *testing.T) {
		numGoroutines := 20
		prefix := "integration-concurrent-store-" + time.Now().Format("20060102150405.000000000")

		var wg sync.WaitGroup
		var successCount atomic.Int32
		var errorCount atomic.Int32

		for i := 0; i < numGoroutines; i++ {
			wg.Add(1)
			go func(idx int) {
				defer wg.Done()
				secretID := fmt.Sprintf("%s-%d", prefix, idx)
				_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
					SecretID: secretID,
					Name:     secretID,
					Data:     []byte(fmt.Sprintf("concurrent-data-%d", idx)),
				})
				if err != nil {
					errorCount.Add(1)
					t.Logf("Concurrent store error %d: %v", idx, err)
				} else {
					successCount.Add(1)
				}
			}(i)
		}

		wg.Wait()
		assert.GreaterOrEqual(t, successCount.Load(), int32(numGoroutines-2),
			"at least 90%% of concurrent store operations should succeed")
	})

	t.Run("Concurrent secret retrieval", func(t *testing.T) {
		// Create a secret first
		secretID := "integration-concurrent-get-" + time.Now().Format("20060102150405.000000000")
		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("concurrent-retrieve-data"),
		})
		require.NoError(t, err)

		numGoroutines := 50
		var wg sync.WaitGroup
		var successCount atomic.Int32

		for i := 0; i < numGoroutines; i++ {
			wg.Add(1)
			go func() {
				defer wg.Done()
				_, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
					SecretID: secretID,
				})
				if err == nil {
					successCount.Add(1)
				}
			}()
		}

		wg.Wait()
		assert.Equal(t, int32(numGoroutines), successCount.Load(),
			"all concurrent retrieve operations should succeed")
	})

	t.Run("Concurrent rotations on same secret", func(t *testing.T) {
		secretID := "integration-concurrent-rotate-" + time.Now().Format("20060102150405.000000000")
		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("initial-value"),
		})
		require.NoError(t, err)

		numGoroutines := 10
		var wg sync.WaitGroup
		var successCount atomic.Int32

		for i := 0; i < numGoroutines; i++ {
			wg.Add(1)
			go func(idx int) {
				defer wg.Done()
				_, err := secrets.RotateSecret(ctx, &service.RotateSecretRequest{
					SecretID: secretID,
					NewData:  []byte(fmt.Sprintf("rotated-value-%d", idx)),
				})
				if err == nil {
					successCount.Add(1)
				}
			}(i)
		}

		wg.Wait()
		// All rotations should succeed even if they happen concurrently
		assert.GreaterOrEqual(t, successCount.Load(), int32(numGoroutines-2))

		// Verify final state
		getResp, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		require.NoError(t, err)
		assert.NotEmpty(t, getResp.Data)
	})

	t.Run("Concurrent read and write operations", func(t *testing.T) {
		secretID := "integration-concurrent-rw-" + time.Now().Format("20060102150405.000000000")
		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("initial-rw-value"),
		})
		require.NoError(t, err)

		var wg sync.WaitGroup
		var readSuccess atomic.Int32
		var writeSuccess atomic.Int32

		// Concurrent reads
		for i := 0; i < 20; i++ {
			wg.Add(1)
			go func() {
				defer wg.Done()
				_, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
					SecretID: secretID,
				})
				if err == nil {
					readSuccess.Add(1)
				}
			}()
		}

		// Concurrent writes
		for i := 0; i < 5; i++ {
			wg.Add(1)
			go func(idx int) {
				defer wg.Done()
				_, err := secrets.RotateSecret(ctx, &service.RotateSecretRequest{
					SecretID: secretID,
					NewData:  []byte(fmt.Sprintf("concurrent-rw-%d", idx)),
				})
				if err == nil {
					writeSuccess.Add(1)
				}
			}(i)
		}

		wg.Wait()
		assert.GreaterOrEqual(t, readSuccess.Load(), int32(18))
		assert.GreaterOrEqual(t, writeSuccess.Load(), int32(3))
	})
}

// =============================================================================
// Validation Error Cases Integration Tests
// =============================================================================

func TestSecretsValidation_Integration(t *testing.T) {
	skipIfNotIntegration(t)

	client, cleanup := newIntegrationClient(t)
	defer cleanup()

	secrets := getSecretsService(t, client)
	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()

	t.Run("Store secret with empty ID returns error", func(t *testing.T) {
		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: "",
			Name:     "test-name",
			Data:     []byte("test-data"),
		})
		require.Error(t, err)
	})

	t.Run("Store secret with empty data behavior", func(t *testing.T) {
		secretID := "test-empty-data-" + time.Now().Format("20060102150405.000000000")
		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     "test-name",
			Data:     []byte{},
		})
		// Implementation should either reject empty data or accept it
		// Both behaviors are valid - assert the behavior is consistent
		if err != nil {
			// Error is expected if implementation rejects empty data
			assert.Error(t, err, "implementation rejects empty data as expected")
		} else {
			// If no error, verify the secret was stored with empty data
			getResp, getErr := secrets.GetSecret(ctx, &service.GetSecretRequest{
				SecretID: secretID,
			})
			require.NoError(t, getErr, "retrieving secret with empty data should succeed")
			assert.Empty(t, getResp.Data, "stored empty data should be retrievable as empty")
		}
	})

	t.Run("Get nonexistent secret returns error", func(t *testing.T) {
		_, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: "nonexistent-secret-" + time.Now().Format("20060102150405.000000000"),
		})
		require.Error(t, err)
	})

	t.Run("Get secret with empty ID returns error", func(t *testing.T) {
		_, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: "",
		})
		require.Error(t, err)
	})

	t.Run("Rotate secret with empty new data behavior", func(t *testing.T) {
		secretID := "test-rotate-empty-" + time.Now().Format("20060102150405.000000000")
		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("initial-data"),
		})
		require.NoError(t, err)

		_, err = secrets.RotateSecret(ctx, &service.RotateSecretRequest{
			SecretID: secretID,
			NewData:  []byte{},
		})
		// Implementation should either reject empty data or accept it
		if err != nil {
			// Error is expected if implementation rejects empty rotation data
			assert.Error(t, err, "implementation rejects empty rotation data as expected")
		} else {
			// If no error, verify the secret was rotated to empty
			getResp, getErr := secrets.GetSecret(ctx, &service.GetSecretRequest{
				SecretID: secretID,
			})
			require.NoError(t, getErr, "retrieving rotated secret should succeed")
			assert.Empty(t, getResp.Data, "secret should be rotated to empty data")
		}
	})

	t.Run("Duplicate secret ID on store updates existing", func(t *testing.T) {
		secretID := "test-duplicate-" + time.Now().Format("20060102150405.000000000")

		// First store
		resp1, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("first-value"),
		})
		require.NoError(t, err)
		assert.Equal(t, uint64(1), resp1.Version)

		// Second store with same ID
		resp2, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("second-value"),
		})
		// Either error or creates new version depending on implementation
		if err == nil {
			assert.GreaterOrEqual(t, resp2.Version, uint64(1))
		}
	})

	t.Run("Version 0 in GetSecretVersion returns error", func(t *testing.T) {
		secretID := "test-version-zero-" + time.Now().Format("20060102150405.000000000")
		_, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID: secretID,
			Name:     secretID,
			Data:     []byte("test-data"),
		})
		require.NoError(t, err)

		_, err = secrets.GetSecretVersion(ctx, &service.GetSecretVersionRequest{
			SecretID: secretID,
			Version:  0,
		})
		require.Error(t, err)
	})

	t.Run("Nil request handling", func(t *testing.T) {
		// These should not panic
		_, err := secrets.GetSecret(ctx, nil)
		assert.Error(t, err)

		_, err = secrets.StoreSecret(ctx, nil)
		assert.Error(t, err)

		_, err = secrets.DeleteSecret(ctx, nil)
		assert.Error(t, err)

		_, err = secrets.RotateSecret(ctx, nil)
		assert.Error(t, err)
	})
}

// =============================================================================
// Secret Lifecycle Integration Tests
// =============================================================================

func TestSecretLifecycle_Integration(t *testing.T) {
	skipIfNotIntegration(t)

	client, cleanup := newIntegrationClient(t)
	defer cleanup()

	secrets := getSecretsService(t, client)
	ctx, cancel := context.WithTimeout(context.Background(), 120*time.Second)
	defer cancel()

	t.Run("Complete secret lifecycle", func(t *testing.T) {
		secretID := "integration-lifecycle-" + time.Now().Format("20060102150405.000000000")

		// 1. Create secret
		storeResp, err := secrets.StoreSecret(ctx, &service.StoreSecretRequest{
			SecretID:    secretID,
			Name:        secretID,
			Data:        []byte("lifecycle-v1"),
			Description: "Lifecycle test secret",
			Metadata: map[string]string{
				"environment": "integration-test",
			},
		})
		require.NoError(t, err)
		t.Logf("Created secret %s version %d", secretID, storeResp.Version)

		// 2. Retrieve secret
		getResp, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		require.NoError(t, err)
		assert.Equal(t, []byte("lifecycle-v1"), getResp.Data)
		t.Log("Retrieved secret successfully")

		// 3. Set rotation policy
		_, err = secrets.SetRotationPolicy(ctx, &service.SetRotationPolicyRequest{
			SecretID: secretID,
			Policy: &service.SecretRotationPolicy{
				Enabled:        true,
				Interval:       1 * time.Hour,
				RetainVersions: 5,
			},
		})
		require.NoError(t, err)
		t.Log("Set rotation policy")

		// 4. Rotate secret multiple times
		for i := 2; i <= 4; i++ {
			rotateResp, err := secrets.RotateSecret(ctx, &service.RotateSecretRequest{
				SecretID: secretID,
				NewData:  []byte(fmt.Sprintf("lifecycle-v%d", i)),
			})
			require.NoError(t, err)
			assert.Equal(t, uint64(i), rotateResp.NewVersion)
			t.Logf("Rotated to version %d", i)
		}

		// 5. List versions
		versionsResp, err := secrets.ListSecretVersions(ctx, &service.ListSecretVersionsRequest{
			SecretID: secretID,
			Limit:    100,
		})
		require.NoError(t, err)
		assert.Equal(t, 4, len(versionsResp.Versions))
		t.Logf("Listed %d versions", len(versionsResp.Versions))

		// 6. Get specific version - data is in Version.Data
		v2Resp, err := secrets.GetSecretVersion(ctx, &service.GetSecretVersionRequest{
			SecretID: secretID,
			Version:  2,
		})
		require.NoError(t, err)
		require.NotNil(t, v2Resp.Version)
		assert.Equal(t, []byte("lifecycle-v2"), v2Resp.Version.Data)
		t.Log("Retrieved version 2")

		// 7. Rollback to version 1
		rollbackResp, err := secrets.RollbackSecret(ctx, &service.RollbackSecretRequest{
			SecretID:      secretID,
			TargetVersion: 1,
		})
		require.NoError(t, err)
		assert.Equal(t, uint64(5), rollbackResp.NewVersion)
		t.Log("Rolled back to version 1")

		// 8. Verify rollback
		currentResp, err := secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		require.NoError(t, err)
		assert.Equal(t, []byte("lifecycle-v1"), currentResp.Data)
		t.Log("Verified rollback")

		// 9. Disable secret
		_, err = secrets.UpdateSecretStatus(ctx, &service.UpdateSecretStatusRequest{
			SecretID: secretID,
			Status:   service.SecretStatusDisabled,
		})
		require.NoError(t, err)
		t.Log("Disabled secret")

		// 10. Re-enable secret
		_, err = secrets.UpdateSecretStatus(ctx, &service.UpdateSecretStatusRequest{
			SecretID: secretID,
			Status:   service.SecretStatusEnabled,
		})
		require.NoError(t, err)
		t.Log("Re-enabled secret")

		// 11. Delete secret
		deleteResp, err := secrets.DeleteSecret(ctx, &service.DeleteSecretRequest{
			SecretID:          secretID,
			PermanentlyDelete: true,
		})
		require.NoError(t, err)
		assert.True(t, deleteResp.Deleted)
		t.Log("Deleted secret")

		// 12. Verify deletion
		_, err = secrets.GetSecret(ctx, &service.GetSecretRequest{
			SecretID: secretID,
		})
		require.Error(t, err)
		t.Log("Verified deletion")

		t.Log("Complete lifecycle test passed")
	})
}
