// TestHandleSDNOperation_MissingFields tests that SDN operations properly
// validate required fields
func TestHandleSDNOperation_MissingFields(t *testing.T) {
	// Note: These tests would require a mock SDN client to be meaningful
	// For now, they verify that the service unavailable check happens first

	logger := logging.DefaultLogger()
	handler := NewQUICServiceHandler(logger)
	ctx := context.Background()

	t.Run("CreateBridge with empty name returns unavailable without SDN client", func(t *testing.T) {
		payload, _ := quic.EncodePayload(&SDNCreateBridgeRequest{Name: ""})
		req := &quic.Request{
			Opcode:  quic.OpSDNCreateBridge,
			Payload: payload,
		}
		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusUnavailable, resp.Status)
	})

	t.Run("CreatePort with empty fields returns unavailable without SDN client", func(t *testing.T) {
		payload, _ := quic.EncodePayload(&SDNCreatePortRequest{BridgeName: "", PortName: ""})
		req := &quic.Request{
			Opcode:  quic.OpSDNCreatePort,
			Payload: payload,
		}
		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusUnavailable, resp.Status)
	})

	t.Run("SetVLAN with empty port name returns unavailable without SDN client", func(t *testing.T) {
		payload, _ := quic.EncodePayload(&SDNSetVLANRequest{PortName: "", VLAN: 100})
		req := &quic.Request{
			Opcode:  quic.OpSDNSetVLAN,
			Payload: payload,
		}
		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusUnavailable, resp.Status)
	})
}

// TestSDNListResponses_Encoding tests list response encoding/decoding
func TestSDNListResponses_Encoding(t *testing.T) {
	t.Run("SDNListBridgesResponse roundtrip", func(t *testing.T) {
		original := &SDNListBridgesResponse{
			Bridges: []*SDNBridge{
				{UUID: "br1-uuid", Name: "br1"},
				{UUID: "br2-uuid", Name: "br2"},
			},
			Total:     2,
			Timestamp: time.Now().Unix(),
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNListBridgesResponse
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.Total, decoded.Total)
		require.Len(t, decoded.Bridges, 2)
		assert.Equal(t, original.Bridges[0].Name, decoded.Bridges[0].Name)
		assert.Equal(t, original.Bridges[1].Name, decoded.Bridges[1].Name)
	})

	t.Run("SDNListPortsResponse roundtrip", func(t *testing.T) {
		original := &SDNListPortsResponse{
			Ports: []*SDNPort{
				{UUID: "p1-uuid", Name: "eth0", Tag: 100},
				{UUID: "p2-uuid", Name: "eth1", Tag: 200},
			},
			Total:     2,
			Timestamp: time.Now().Unix(),
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNListPortsResponse
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.Total, decoded.Total)
		require.Len(t, decoded.Ports, 2)
		assert.Equal(t, original.Ports[0].Name, decoded.Ports[0].Name)
		assert.Equal(t, original.Ports[0].Tag, decoded.Ports[0].Tag)
	})

	t.Run("SDNListFlowsResponse roundtrip", func(t *testing.T) {
		original := &SDNListFlowsResponse{
			Flows: []*SDNFlow{
				{Table: 0, Priority: 100, Match: "in_port=1", Actions: "output:2"},
				{Table: 0, Priority: 50, Match: "in_port=2", Actions: "drop"},
			},
			Total:     2,
			Timestamp: time.Now().Unix(),
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNListFlowsResponse
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.Total, decoded.Total)
		require.Len(t, decoded.Flows, 2)
		assert.Equal(t, original.Flows[0].Priority, decoded.Flows[0].Priority)
		assert.Equal(t, original.Flows[1].Actions, decoded.Flows[1].Actions)
	})

	t.Run("SDNListPoliciesResponse roundtrip", func(t *testing.T) {
		original := &SDNListPoliciesResponse{
			Policies: []*SDNPolicy{
				{PortID: "p1", TenantID: "t1", VLAN: 100},
				{PortID: "p2", TenantID: "t2", VLAN: 200},
			},
			Total:     2,
			Timestamp: time.Now().Unix(),
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNListPoliciesResponse
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.Total, decoded.Total)
		require.Len(t, decoded.Policies, 2)
		assert.Equal(t, original.Policies[0].PortID, decoded.Policies[0].PortID)
		assert.Equal(t, original.Policies[1].VLAN, decoded.Policies[1].VLAN)
	})
}

// TestSDNGetResponses_Encoding tests get response encoding/decoding
func TestSDNGetResponses_Encoding(t *testing.T) {
	t.Run("SDNGetBridgeResponse roundtrip", func(t *testing.T) {
		original := &SDNGetBridgeResponse{
			Bridge: &SDNBridge{
				UUID: "bridge-uuid",
				Name: "br-test",
