// TestHandleSDNOperation_ServiceNotAvailable tests that SDN operations return
// StatusUnavailable when the SDN service is not configured
func TestHandleSDNOperation_ServiceNotAvailable(t *testing.T) {
	logger := logging.DefaultLogger()
	handler := NewQUICServiceHandler(logger)

	ctx := context.Background()

	testCases := []struct {
		name   string
		opcode byte
	}{
		{"GetBridge", quic.OpSDNGetBridge},
		{"ListBridges", quic.OpSDNListBridges},
		{"ListPorts", quic.OpSDNListPorts},
		{"GetPortState", quic.OpSDNGetPortState},
		{"SetPortState", quic.OpSDNSetPortState},
		{"SetVLAN", quic.OpSDNSetVLAN},
		{"GetVLAN", quic.OpSDNGetVLAN},
		{"AddFlow", quic.OpSDNAddFlow},
		{"DeleteFlow", quic.OpSDNDeleteFlow},
		{"GetFlow", quic.OpSDNGetFlow},
		{"ListFlows", quic.OpSDNListFlows},
		{"GetMetrics", quic.OpSDNGetMetrics},
		{"CreateBridge", quic.OpSDNCreateBridge},
		{"DeleteBridge", quic.OpSDNDeleteBridge},
		{"CreatePort", quic.OpSDNCreatePort},
		{"DeletePort", quic.OpSDNDeletePort},
		{"GetPort", quic.OpSDNGetPort},
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
			req := &quic.Request{
				Opcode:  tc.opcode,
				Payload: []byte{},
			}
			resp := handler.HandleRequest(ctx, req)

			assert.Equal(t, quic.StatusUnavailable, resp.Status)
			assert.Contains(t, string(resp.Payload), "sdn")
		})
	}
}

// TestHandleSDNPolicyOperations_EngineNotConfigured tests that policy operations
// return proper error when policy engine is not configured
func TestHandleSDNPolicyOperations_EngineNotConfigured(t *testing.T) {
	logger := logging.DefaultLogger()
	// Create a mock OVS client to allow SDN operations to route properly
	// but policy engine operations should still fail
	handler := NewQUICServiceHandler(logger)
	// We cannot set a real OVS client without a socket, so policy operations
	// will fail at the SDN service level first

	ctx := context.Background()

	testCases := []struct {
		name   string
		opcode byte
	}{
		{"ApplyPolicy", quic.OpSDNApplyPolicy},
		{"DeletePolicy", quic.OpSDNDeletePolicy},
		{"GetPolicy", quic.OpSDNGetPolicy},
		{"ListPolicies", quic.OpSDNListPolicies},
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
			req := &quic.Request{
				Opcode:  tc.opcode,
				Payload: []byte{},
			}
			resp := handler.HandleRequest(ctx, req)

			// Should fail because SDN service is not configured
			assert.Equal(t, quic.StatusUnavailable, resp.Status)
		})
	}
}

// TestSDNRequestResponse_Encoding tests that SDN request/response types
// encode and decode correctly with MessagePack
func TestSDNRequestResponse_Encoding(t *testing.T) {
	t.Run("SDNCreateBridgeRequest roundtrip", func(t *testing.T) {
		original := &SDNCreateBridgeRequest{
			Name: "br-test",
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNCreateBridgeRequest
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.Name, decoded.Name)
	})

	t.Run("SDNCreateBridgeResponse roundtrip", func(t *testing.T) {
		original := &SDNCreateBridgeResponse{
			Name:      "br-test",
			UUID:      "abc-123-def-456",
			Timestamp: time.Now().Unix(),
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNCreateBridgeResponse
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.Name, decoded.Name)
		assert.Equal(t, original.UUID, decoded.UUID)
		assert.Equal(t, original.Timestamp, decoded.Timestamp)
	})

	t.Run("SDNDeleteBridgeRequest roundtrip", func(t *testing.T) {
		original := &SDNDeleteBridgeRequest{
			Name: "br-test",
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNDeleteBridgeRequest
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.Name, decoded.Name)
	})

	t.Run("SDNDeleteBridgeResponse roundtrip", func(t *testing.T) {
		original := &SDNDeleteBridgeResponse{
			Name:      "br-test",
			Deleted:   true,
			Timestamp: time.Now().Unix(),
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNDeleteBridgeResponse
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.Name, decoded.Name)
		assert.Equal(t, original.Deleted, decoded.Deleted)
	})

	t.Run("SDNGetBridgeRequest roundtrip", func(t *testing.T) {
		original := &SDNGetBridgeRequest{
			Name: "br-test",
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNGetBridgeRequest
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.Name, decoded.Name)
	})

	t.Run("SDNBridge roundtrip", func(t *testing.T) {
		original := &SDNBridge{
			UUID:          "abc-123",
			Name:          "br-test",
			DatapathType:  "system",
			FailMode:      "secure",
			Ports:         []string{"eth0", "eth1"},
			FlowProtocols: []string{"OpenFlow13"},
			STP:           true,
			RSTP:          false,
			McastSnooping: true,
			ExternalIDs:   map[string]string{"key1": "val1"},
			OtherConfig:   map[string]string{"cfg1": "cfg_val1"},
			Status:        map[string]string{"status1": "ok"},
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNBridge
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.UUID, decoded.UUID)
		assert.Equal(t, original.Name, decoded.Name)
		assert.Equal(t, original.DatapathType, decoded.DatapathType)
		assert.Equal(t, original.FailMode, decoded.FailMode)
		assert.Equal(t, original.Ports, decoded.Ports)
		assert.Equal(t, original.FlowProtocols, decoded.FlowProtocols)
		assert.Equal(t, original.STP, decoded.STP)
		assert.Equal(t, original.RSTP, decoded.RSTP)
		assert.Equal(t, original.McastSnooping, decoded.McastSnooping)
		assert.Equal(t, original.ExternalIDs, decoded.ExternalIDs)
		assert.Equal(t, original.OtherConfig, decoded.OtherConfig)
		assert.Equal(t, original.Status, decoded.Status)
	})

	t.Run("SDNCreatePortRequest roundtrip", func(t *testing.T) {
		original := &SDNCreatePortRequest{
			BridgeName: "br-test",
			PortName:   "eth0",
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNCreatePortRequest
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.BridgeName, decoded.BridgeName)
		assert.Equal(t, original.PortName, decoded.PortName)
	})

	t.Run("SDNPort roundtrip", func(t *testing.T) {
		original := &SDNPort{
			UUID:        "port-uuid-123",
			Name:        "eth0",
			Interfaces:  []string{"eth0"},
			Tag:         100,
			Trunks:      []int64{100, 200, 300},
			VLANMode:    "access",
			MAC:         "00:11:22:33:44:55",
			ExternalIDs: map[string]string{"port-id": "123"},
			OtherConfig: map[string]string{"cfg": "val"},
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNPort
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.UUID, decoded.UUID)
		assert.Equal(t, original.Name, decoded.Name)
		assert.Equal(t, original.Interfaces, decoded.Interfaces)
		assert.Equal(t, original.Tag, decoded.Tag)
		assert.Equal(t, original.Trunks, decoded.Trunks)
		assert.Equal(t, original.VLANMode, decoded.VLANMode)
		assert.Equal(t, original.MAC, decoded.MAC)
		assert.Equal(t, original.ExternalIDs, decoded.ExternalIDs)
		assert.Equal(t, original.OtherConfig, decoded.OtherConfig)
	})

	t.Run("SDNSetPortStateRequest roundtrip", func(t *testing.T) {
		original := &SDNSetPortStateRequest{
			PortName: "eth0",
			State:    "authorized",
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNSetPortStateRequest
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.PortName, decoded.PortName)
		assert.Equal(t, original.State, decoded.State)
	})

	t.Run("SDNSetVLANRequest roundtrip", func(t *testing.T) {
		original := &SDNSetVLANRequest{
			PortName: "eth0",
			VLAN:     100,
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNSetVLANRequest
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.PortName, decoded.PortName)
		assert.Equal(t, original.VLAN, decoded.VLAN)
	})

	t.Run("SDNAddFlowRequest roundtrip", func(t *testing.T) {
		original := &SDNAddFlowRequest{
			BridgeName:  "br-test",
			Table:       0,
			Priority:    100,
			Match:       "in_port=1,dl_src=00:11:22:33:44:55",
			Actions:     "output:2",
			Cookie:      "0x1234",
			IdleTimeout: 300,
			HardTimeout: 600,
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNAddFlowRequest
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.BridgeName, decoded.BridgeName)
		assert.Equal(t, original.Table, decoded.Table)
		assert.Equal(t, original.Priority, decoded.Priority)
		assert.Equal(t, original.Match, decoded.Match)
		assert.Equal(t, original.Actions, decoded.Actions)
		assert.Equal(t, original.Cookie, decoded.Cookie)
		assert.Equal(t, original.IdleTimeout, decoded.IdleTimeout)
		assert.Equal(t, original.HardTimeout, decoded.HardTimeout)
	})

	t.Run("SDNFlow roundtrip", func(t *testing.T) {
		original := &SDNFlow{
			Table:       0,
			Priority:    100,
			Match:       "in_port=1",
			Actions:     "output:2",
			Cookie:      "0x1234",
			Duration:    3600,
			IdleAge:     60,
			HardAge:     120,
			PacketCount: 1000,
			ByteCount:   64000,
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNFlow
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.Table, decoded.Table)
		assert.Equal(t, original.Priority, decoded.Priority)
		assert.Equal(t, original.Match, decoded.Match)
		assert.Equal(t, original.Actions, decoded.Actions)
		assert.Equal(t, original.Cookie, decoded.Cookie)
		assert.Equal(t, original.Duration, decoded.Duration)
		assert.Equal(t, original.IdleAge, decoded.IdleAge)
		assert.Equal(t, original.HardAge, decoded.HardAge)
		assert.Equal(t, original.PacketCount, decoded.PacketCount)
		assert.Equal(t, original.ByteCount, decoded.ByteCount)
	})

	t.Run("SDNApplyPolicyRequest roundtrip", func(t *testing.T) {
		original := &SDNApplyPolicyRequest{
			PortID:   "port-123",
			TenantID: "tenant-456",
			VLAN:     100,
			ACLs: []*SDNACLRule{
				{
					Priority:    100,
					Action:      "allow",
					Description: "Allow web traffic",
					Match: &SDNFlowMatch{
						InPort:  "1",
						EthSrc:  "00:11:22:33:44:55",
						EthDst:  "ff:ff:ff:ff:ff:ff",
						EthType: 0x0800,
						VLANVid: 100,
						IPProto: 6,
						IPv4Src: "192.168.1.0/24",
						IPv4Dst: "10.0.0.0/8",
						TCPSrc:  0,
						TCPDst:  80,
						UDPSrc:  0,
						UDPDst:  0,
					},
				},
			},
			Metadata: map[string]string{"device": "sensor1"},
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNApplyPolicyRequest
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.PortID, decoded.PortID)
		assert.Equal(t, original.TenantID, decoded.TenantID)
		assert.Equal(t, original.VLAN, decoded.VLAN)
		require.Len(t, decoded.ACLs, 1)
		assert.Equal(t, original.ACLs[0].Priority, decoded.ACLs[0].Priority)
		assert.Equal(t, original.ACLs[0].Action, decoded.ACLs[0].Action)
		require.NotNil(t, decoded.ACLs[0].Match)
		assert.Equal(t, original.ACLs[0].Match.InPort, decoded.ACLs[0].Match.InPort)
		assert.Equal(t, original.ACLs[0].Match.EthSrc, decoded.ACLs[0].Match.EthSrc)
		assert.Equal(t, original.ACLs[0].Match.TCPDst, decoded.ACLs[0].Match.TCPDst)
		assert.Equal(t, original.Metadata, decoded.Metadata)
	})

	t.Run("SDNPolicy roundtrip", func(t *testing.T) {
		original := &SDNPolicy{
			PortID:    "port-123",
			TenantID:  "tenant-456",
			VLAN:      100,
			ExpiresAt: time.Now().Add(time.Hour).Unix(),
			IssuedAt:  time.Now().Unix(),
			Metadata:  map[string]string{"key": "value"},
			ACLs: []*SDNACLRule{
				{
					Priority:    50,
					Action:      "deny",
					Description: "Block SSH",
					Match: &SDNFlowMatch{
						TCPDst: 22,
					},
				},
			},
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNPolicy
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.PortID, decoded.PortID)
		assert.Equal(t, original.TenantID, decoded.TenantID)
		assert.Equal(t, original.VLAN, decoded.VLAN)
		assert.Equal(t, original.ExpiresAt, decoded.ExpiresAt)
		assert.Equal(t, original.IssuedAt, decoded.IssuedAt)
		assert.Equal(t, original.Metadata, decoded.Metadata)
		require.Len(t, decoded.ACLs, 1)
		assert.Equal(t, original.ACLs[0].Priority, decoded.ACLs[0].Priority)
	})

	t.Run("SDNMetrics roundtrip", func(t *testing.T) {
		original := &SDNMetrics{
			BridgeCount:     3,
			PortCount:       15,
			FlowCount:       120,
			PolicyCount:     8,
			TotalPackets:    1000000,
			TotalBytes:      1500000000,
			ActivePorts:     10,
			BlockedPorts:    2,
			AuthorizedPorts: 8,
			Timestamp:       time.Now().Unix(),
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNMetrics
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		assert.Equal(t, original.BridgeCount, decoded.BridgeCount)
		assert.Equal(t, original.PortCount, decoded.PortCount)
		assert.Equal(t, original.FlowCount, decoded.FlowCount)
		assert.Equal(t, original.PolicyCount, decoded.PolicyCount)
		assert.Equal(t, original.TotalPackets, decoded.TotalPackets)
		assert.Equal(t, original.TotalBytes, decoded.TotalBytes)
		assert.Equal(t, original.ActivePorts, decoded.ActivePorts)
		assert.Equal(t, original.BlockedPorts, decoded.BlockedPorts)
		assert.Equal(t, original.AuthorizedPorts, decoded.AuthorizedPorts)
	})
}

// TestConvertOVSBridgeToSDNBridge tests bridge conversion
func TestConvertOVSBridgeToSDNBridge(t *testing.T) {
	t.Run("nil bridge returns nil", func(t *testing.T) {
		result := convertOVSBridgeToSDNBridge(nil)
		assert.Nil(t, result)
	})

	t.Run("converts all fields correctly", func(t *testing.T) {
		bridge := &ovs.Bridge{
			UUID:          "bridge-uuid-123",
			Name:          "br-test",
			DatapathType:  "system",
			FailMode:      "secure",
			Ports:         []string{"eth0", "eth1"},
			FlowProtocols: []string{"OpenFlow13"},
			STP:           true,
			RSTP:          false,
			McastSnooping: true,
			ExternalIDs:   map[string]string{"key": "value"},
			OtherConfig:   map[string]string{"cfg": "val"},
			Status:        map[string]string{"status": "active"},
		}

		result := convertOVSBridgeToSDNBridge(bridge)
		require.NotNil(t, result)

		assert.Equal(t, bridge.UUID, result.UUID)
		assert.Equal(t, bridge.Name, result.Name)
		assert.Equal(t, bridge.DatapathType, result.DatapathType)
		assert.Equal(t, bridge.FailMode, result.FailMode)
		assert.Equal(t, bridge.Ports, result.Ports)
		assert.Equal(t, bridge.FlowProtocols, result.FlowProtocols)
		assert.Equal(t, bridge.STP, result.STP)
		assert.Equal(t, bridge.RSTP, result.RSTP)
		assert.Equal(t, bridge.McastSnooping, result.McastSnooping)
		assert.Equal(t, bridge.ExternalIDs, result.ExternalIDs)
		assert.Equal(t, bridge.OtherConfig, result.OtherConfig)
		assert.Equal(t, bridge.Status, result.Status)
	})
}

// TestConvertOVSPortToSDNPort tests port conversion
func TestConvertOVSPortToSDNPort(t *testing.T) {
	t.Run("nil port returns nil", func(t *testing.T) {
		result := convertOVSPortToSDNPort(nil)
		assert.Nil(t, result)
	})

	t.Run("converts all fields correctly", func(t *testing.T) {
		port := &ovs.Port{
			UUID:        "port-uuid-123",
			Name:        "eth0",
			Interfaces:  []string{"eth0"},
			Tag:         100,
			Trunks:      []int64{100, 200},
			VLANMode:    "access",
			MAC:         "00:11:22:33:44:55",
			ExternalIDs: map[string]string{"device-id": "123"},
			OtherConfig: map[string]string{"qos": "high"},
		}

		result := convertOVSPortToSDNPort(port)
		require.NotNil(t, result)

		assert.Equal(t, port.UUID, result.UUID)
		assert.Equal(t, port.Name, result.Name)
		assert.Equal(t, port.Interfaces, result.Interfaces)
		assert.Equal(t, port.Tag, result.Tag)
		assert.Equal(t, port.Trunks, result.Trunks)
		assert.Equal(t, port.VLANMode, result.VLANMode)
		assert.Equal(t, port.MAC, result.MAC)
		assert.Equal(t, port.ExternalIDs, result.ExternalIDs)
		assert.Equal(t, port.OtherConfig, result.OtherConfig)
	})
}

// TestConvertOVSFlowToSDNFlow tests flow conversion
func TestConvertOVSFlowToSDNFlow(t *testing.T) {
	t.Run("nil flow returns nil", func(t *testing.T) {
		result := convertOVSFlowToSDNFlow(nil)
		assert.Nil(t, result)
	})

	t.Run("converts all fields correctly", func(t *testing.T) {
		flow := &ovs.Flow{
			Table:       0,
			Priority:    100,
			Match:       "in_port=1",
			Actions:     "output:2",
			Cookie:      "0x1234",
			Duration:    3600,
			IdleAge:     60,
			HardAge:     120,
			PacketCount: 5000,
			ByteCount:   320000,
		}

		result := convertOVSFlowToSDNFlow(flow)
		require.NotNil(t, result)

		assert.Equal(t, flow.Table, result.Table)
		assert.Equal(t, flow.Priority, result.Priority)
		assert.Equal(t, flow.Match, result.Match)
		assert.Equal(t, flow.Actions, result.Actions)
		assert.Equal(t, flow.Cookie, result.Cookie)
		assert.Equal(t, flow.Duration, result.Duration)
		assert.Equal(t, flow.IdleAge, result.IdleAge)
		assert.Equal(t, flow.HardAge, result.HardAge)
		assert.Equal(t, flow.PacketCount, result.PacketCount)
		assert.Equal(t, flow.ByteCount, result.ByteCount)
	})
}


// TestConvertSDNRequestToPortPolicy tests policy conversion from SDN request
func TestConvertSDNRequestToPortPolicy(t *testing.T) {
	t.Run("converts basic fields", func(t *testing.T) {
		req := &SDNApplyPolicyRequest{
			PortID:   "port-123",
			TenantID: "tenant-456",
			VLAN:     100,
			Metadata: map[string]string{"key": "value"},
		}

		result := convertSDNRequestToPortPolicy(req)
		require.NotNil(t, result)

		assert.Equal(t, req.TenantID, result.TenantID)
		assert.Equal(t, req.VLAN, result.VLAN)
		assert.Equal(t, req.Metadata, result.Metadata)
		assert.NotZero(t, result.IssuedAt)
	})

	t.Run("converts ACL rules", func(t *testing.T) {
		req := &SDNApplyPolicyRequest{
			PortID:   "port-123",
			TenantID: "tenant-456",
			VLAN:     100,
			ACLs: []*SDNACLRule{
				{
					Priority:    100,
					Action:      "allow",
					Description: "Allow HTTP",
					Match: &SDNFlowMatch{
						InPort:  "1",
						EthSrc:  "00:11:22:33:44:55",
						EthDst:  "ff:ff:ff:ff:ff:ff",
						EthType: 0x0800,
						VLANVid: 100,
						IPProto: 6,
						IPv4Src: "192.168.1.0/24",
						IPv4Dst: "10.0.0.0/8",
						TCPSrc:  12345,
						TCPDst:  80,
						UDPSrc:  0,
						UDPDst:  0,
					},
				},
				{
					Priority:    50,
					Action:      "deny",
					Description: "Block all else",
				},
			},
		}

		result := convertSDNRequestToPortPolicy(req)
		require.NotNil(t, result)
		require.Len(t, result.ACLs, 2)

		// First ACL with match
		assert.Equal(t, 100, result.ACLs[0].Priority)
		assert.Equal(t, "Allow HTTP", result.ACLs[0].Description)
		assert.Equal(t, policy.FlowActionType("allow"), result.ACLs[0].Action.Type)
		assert.Equal(t, "1", result.ACLs[0].Match.InPort)
		assert.Equal(t, "00:11:22:33:44:55", result.ACLs[0].Match.EthSrc)
		assert.Equal(t, uint16(0x0800), result.ACLs[0].Match.EthType)
		assert.Equal(t, uint16(80), result.ACLs[0].Match.TCPDst)

		// Second ACL without match
		assert.Equal(t, 50, result.ACLs[1].Priority)
		assert.Equal(t, policy.FlowActionType("deny"), result.ACLs[1].Action.Type)
	})

	t.Run("handles nil ACL match", func(t *testing.T) {
		req := &SDNApplyPolicyRequest{
			PortID:   "port-123",
			TenantID: "tenant-456",
			VLAN:     100,
			ACLs: []*SDNACLRule{
				{
					Priority: 100,
					Action:   "allow",
					Match:    nil, // nil match
				},
			},
		}

		result := convertSDNRequestToPortPolicy(req)
		require.NotNil(t, result)
		require.Len(t, result.ACLs, 1)
		// Match should have zero values
		assert.Empty(t, result.ACLs[0].Match.InPort)
	})
}

// TestConvertPortPolicyToSDNPolicy tests policy conversion to SDN response
func TestConvertPortPolicyToSDNPolicy(t *testing.T) {
	t.Run("nil policy returns nil", func(t *testing.T) {
		result := convertPortPolicyToSDNPolicy("port-123", nil)
		assert.Nil(t, result)
	})

	t.Run("converts basic fields", func(t *testing.T) {
		now := time.Now()
		expires := now.Add(time.Hour)

		pp := &policy.PortPolicy{
			TenantID:  "tenant-456",
			VLAN:      100,
			IssuedAt:  now,
			ExpiresAt: expires,
			Metadata:  map[string]string{"device": "sensor1"},
		}

		result := convertPortPolicyToSDNPolicy("port-123", pp)
		require.NotNil(t, result)

		assert.Equal(t, "port-123", result.PortID)
		assert.Equal(t, pp.TenantID, result.TenantID)
		assert.Equal(t, pp.VLAN, result.VLAN)
		assert.Equal(t, now.Unix(), result.IssuedAt)
		assert.Equal(t, expires.Unix(), result.ExpiresAt)
		assert.Equal(t, pp.Metadata, result.Metadata)
	})

	t.Run("converts ACL rules", func(t *testing.T) {
		pp := &policy.PortPolicy{
			TenantID: "tenant-456",
			VLAN:     100,
			IssuedAt: time.Now(),
			ACLs: []policy.ACLRule{
				{
					Priority:    100,
					Description: "Allow web",
					Action: policy.FlowAction{
						Type: policy.FlowActionAllow,
					},
					Match: policy.FlowMatch{
						InPort:  "1",
						EthSrc:  "00:11:22:33:44:55",
						TCPDst:  80,
						IPv4Src: "192.168.1.0/24",
					},
				},
			},
		}

		result := convertPortPolicyToSDNPolicy("port-123", pp)
		require.NotNil(t, result)
		require.Len(t, result.ACLs, 1)

		assert.Equal(t, 100, result.ACLs[0].Priority)
		assert.Equal(t, "Allow web", result.ACLs[0].Description)
		assert.Equal(t, string(policy.FlowActionAllow), result.ACLs[0].Action)
		require.NotNil(t, result.ACLs[0].Match)
		assert.Equal(t, "1", result.ACLs[0].Match.InPort)
		assert.Equal(t, "00:11:22:33:44:55", result.ACLs[0].Match.EthSrc)
		assert.Equal(t, uint16(80), result.ACLs[0].Match.TCPDst)
	})

	t.Run("handles zero expiry time", func(t *testing.T) {
		pp := &policy.PortPolicy{
			TenantID: "tenant-456",
			VLAN:     100,
			IssuedAt: time.Now(),
			// ExpiresAt is zero value
		}

		result := convertPortPolicyToSDNPolicy("port-123", pp)
		require.NotNil(t, result)
		assert.Equal(t, int64(0), result.ExpiresAt)
	})
}

// TestSDNErrors tests SDN error type behaviors
func TestSDNErrors(t *testing.T) {
	t.Run("ErrSDNPolicyEngineNotConfigured error message", func(t *testing.T) {
		err := ErrSDNPolicyEngineNotConfigured{}
		assert.Equal(t, "SDN policy engine not configured", err.Error())
	})

	t.Run("ErrSDNInvalidPortState error message", func(t *testing.T) {
		err := ErrSDNInvalidPortState{State: "invalid_state"}
		assert.Equal(t, "invalid port state: invalid_state", err.Error())
	})

	t.Run("ErrSDNPolicyNotFound error message", func(t *testing.T) {
		err := ErrSDNPolicyNotFound{PolicyID: "policy-123"}
		assert.Equal(t, "SDN policy not found: policy-123", err.Error())
	})

	t.Run("ErrSDNInvalidPolicy error message", func(t *testing.T) {
		err := ErrSDNInvalidPolicy{Reason: "missing tenant ID"}
		assert.Equal(t, "invalid SDN policy: missing tenant ID", err.Error())
	})

	t.Run("ErrSDNSetPortStateFailed error message and unwrap", func(t *testing.T) {
		cause := assert.AnError
		err := ErrSDNSetPortStateFailed{PortID: "port-123", Cause: cause}
		assert.Contains(t, err.Error(), "failed to set port state for port-123")
		assert.Equal(t, cause, err.Unwrap())
	})

	t.Run("ErrSDNApplyPolicyFailed error message and unwrap", func(t *testing.T) {
		cause := assert.AnError
		err := ErrSDNApplyPolicyFailed{PolicyID: "policy-123", Cause: cause}
		assert.Contains(t, err.Error(), "failed to apply policy policy-123")
		assert.Equal(t, cause, err.Unwrap())
	})

	t.Run("ErrSDNBridgeNotFound error message", func(t *testing.T) {
		err := ErrSDNBridgeNotFound{BridgeName: "br-test"}
		assert.Equal(t, "SDN bridge not found: br-test", err.Error())
	})

	t.Run("ErrSDNPortNotFound error message", func(t *testing.T) {
		err := ErrSDNPortNotFound{BridgeName: "br-test", PortName: "eth0"}
		assert.Equal(t, "SDN port not found: eth0 on bridge br-test", err.Error())
	})

	t.Run("ErrSDNMissingParameter error message", func(t *testing.T) {
		err := ErrSDNMissingParameter{Parameter: "bridge_name"}
		assert.Equal(t, "missing required parameter: bridge_name", err.Error())
	})

	t.Run("ErrSDNOperationNotImplemented error message", func(t *testing.T) {
		err := ErrSDNOperationNotImplemented{Operation: "SomeOperation"}
		assert.Equal(t, "SDN operation not implemented: SomeOperation", err.Error())
	})
}

