		require.NoError(t, err)

		require.NotNil(t, decoded.Bridge)
		assert.Equal(t, original.Bridge.Name, decoded.Bridge.Name)
	})

	t.Run("SDNGetPortResponse roundtrip", func(t *testing.T) {
