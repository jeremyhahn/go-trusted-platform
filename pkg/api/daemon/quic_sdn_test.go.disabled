		assert.Equal(t, original.PortName, decoded.PortName)
		assert.Equal(t, original.VLAN, decoded.VLAN)
	})

	t.Run("SDNGetPolicyResponse roundtrip", func(t *testing.T) {
		original := &SDNGetPolicyResponse{
			Policy: &SDNPolicy{
				PortID:   "port-123",
				TenantID: "tenant-456",
				VLAN:     100,
			},
			Timestamp: time.Now().Unix(),
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNGetPolicyResponse
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		require.NotNil(t, decoded.Policy)
		assert.Equal(t, original.Policy.PortID, decoded.Policy.PortID)
		assert.Equal(t, original.Policy.TenantID, decoded.Policy.TenantID)
	})

	t.Run("SDNGetMetricsResponse roundtrip", func(t *testing.T) {
		original := &SDNGetMetricsResponse{
			Metrics: &SDNMetrics{
				BridgeCount:  3,
				PortCount:    15,
				FlowCount:    120,
				TotalPackets: 1000000,
			},
			Timestamp: time.Now().Unix(),
		}

		encoded, err := quic.EncodePayload(original)
		require.NoError(t, err)

		var decoded SDNGetMetricsResponse
		err = quic.DecodePayload(encoded, &decoded)
		require.NoError(t, err)

		require.NotNil(t, decoded.Metrics)
		assert.Equal(t, original.Metrics.BridgeCount, decoded.Metrics.BridgeCount)
		assert.Equal(t, original.Metrics.TotalPackets, decoded.Metrics.TotalPackets)
	})
}

// TestReadinessResponse_IncludesSDNAndPolicy tests that readiness check
// includes SDN and policy services
func TestReadinessResponse_IncludesSDNAndPolicy(t *testing.T) {
	logger := logging.DefaultLogger()
	handler := NewQUICServiceHandler(logger)

	ctx := context.Background()
	req := &quic.Request{
		Opcode:  quic.OpReadiness,
		Payload: []byte{},
	}

	resp := handler.HandleRequest(ctx, req)
	assert.Equal(t, quic.StatusOK, resp.Status)

	var readiness ReadinessResponse
	err := quic.DecodePayload(resp.Payload, &readiness)
	require.NoError(t, err)

	// Both SDN and policy should be NOT_CONFIGURED when nil
	assert.Equal(t, "NOT_CONFIGURED", readiness.Services["sdn"])
	assert.Equal(t, "NOT_CONFIGURED", readiness.Services["policy"])
}
