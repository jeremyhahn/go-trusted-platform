// TestHandleDeviceAttest tests device attestation
func TestHandleDeviceAttest(t *testing.T) {
	logger := logging.DefaultLogger()
	deviceSvc := newMockDeviceService()
	deviceSvc.devices[1] = &entities.Device{ID: 1, Serial: "SN001"}
	handler := NewQUICServiceHandler(logger, WithQUICDeviceService(deviceSvc))

	ctx := context.Background()

	t.Run("attest by ID", func(t *testing.T) {
		attestReq := &DeviceAttestRequest{
			ID:    1,
			Nonce: []byte("testnonce"),
			Quote: []byte("testquote"),
		}

		payload, err := quic.EncodePayload(attestReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceAttest,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusOK, resp.Status)

		var attestResp DeviceAttestResponse
		err = quic.DecodePayload(resp.Payload, &attestResp)
		require.NoError(t, err)
		assert.Equal(t, uint64(1), attestResp.ID)
		// Attestation not yet implemented, so verified should be false
		assert.False(t, attestResp.Verified)
	})

	t.Run("missing identifier", func(t *testing.T) {
		attestReq := &DeviceAttestRequest{
			Nonce: []byte("testnonce"),
		}

		payload, err := quic.EncodePayload(attestReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceAttest,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusInvalidArgument, resp.Status)
	})

	t.Run("device not found", func(t *testing.T) {
		attestReq := &DeviceAttestRequest{ID: 999}

		payload, err := quic.EncodePayload(attestReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceAttest,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusNotFound, resp.Status)
	})
}

