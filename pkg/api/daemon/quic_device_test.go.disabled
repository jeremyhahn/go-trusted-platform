// TestHandleDevice_ServiceNotAvailable tests that Device operations return
// StatusUnavailable when the Device service is not configured
func TestHandleDevice_ServiceNotAvailable(t *testing.T) {
	logger := logging.DefaultLogger()
	handler := NewQUICServiceHandler(logger)

	ctx := context.Background()

	testCases := []struct {
		name   string
		opcode byte
	}{
		{"Register", quic.OpDeviceRegister},
		{"Unregister", quic.OpDeviceUnregister},
		{"Get", quic.OpDeviceGet},
		{"List", quic.OpDeviceList},
		{"Update", quic.OpDeviceUpdate},
		{"GetProfile", quic.OpDeviceGetProfile},
		{"SetProfile", quic.OpDeviceSetProfile},
		{"ListProfiles", quic.OpDeviceListProfiles},
		{"CreateProfile", quic.OpDeviceCreateProfile},
		{"DeleteProfile", quic.OpDeviceDeleteProfile},
		{"Attest", quic.OpDeviceAttest},
		{"Activate", quic.OpDeviceActivate},
		{"Deactivate", quic.OpDeviceDeactivate},
		{"GetState", quic.OpDeviceGetState},
		{"GetMetrics", quic.OpDeviceGetMetrics},
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
			req := &quic.Request{
				Opcode:  tc.opcode,
				Payload: []byte{},
			}
			resp := handler.HandleRequest(ctx, req)

			assert.Equal(t, quic.StatusUnavailable, resp.Status)
			assert.Contains(t, string(resp.Payload), "device")
		})
	}
}

// TestHandleDeviceRegister tests device registration
func TestHandleDeviceRegister(t *testing.T) {
	logger := logging.DefaultLogger()
	deviceSvc := newMockDeviceService()
	handler := NewQUICServiceHandler(logger, WithQUICDeviceService(deviceSvc))

	ctx := context.Background()

	t.Run("successful registration", func(t *testing.T) {
		regReq := &DeviceRegisterRequest{
			ID:         1,
			Serial:     "SN001",
			Model:      "TestTPM",
			AttestPub:  "attestpubkey",
			SigningPub: "signingpubkey",
			EKCert:     "ekcert",
			HashAlgoID: 11, // SHA256
		}

		payload, err := quic.EncodePayload(regReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceRegister,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusOK, resp.Status)

		var regResp DeviceRegisterResponse
		err = quic.DecodePayload(resp.Payload, &regResp)
		require.NoError(t, err)
		assert.Equal(t, uint64(1), regResp.ID)
		assert.Equal(t, "SN001", regResp.Serial)
		assert.Equal(t, "TestTPM", regResp.Model)

		// Verify device was saved
		_, exists := deviceSvc.devices[1]
		assert.True(t, exists)
	})

	t.Run("missing ID", func(t *testing.T) {
		regReq := &DeviceRegisterRequest{
			Serial: "SN001",
			Model:  "TestTPM",
		}

		payload, err := quic.EncodePayload(regReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceRegister,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusInvalidArgument, resp.Status)
		assert.Contains(t, string(resp.Payload), "id")
	})

	t.Run("save error", func(t *testing.T) {
		errorDeviceSvc := newMockDeviceService()
		errorDeviceSvc.saveErr = errors.New("save failed")
		errorHandler := NewQUICServiceHandler(logger, WithQUICDeviceService(errorDeviceSvc))

		regReq := &DeviceRegisterRequest{
			ID:     2,
			Serial: "SN002",
		}

		payload, err := quic.EncodePayload(regReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceRegister,
			Payload: payload,
		}

		resp := errorHandler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusInternalError, resp.Status)
	})

	t.Run("invalid payload", func(t *testing.T) {
		req := &quic.Request{
			Opcode:  quic.OpDeviceRegister,
			Payload: []byte{0xFF, 0xFF}, // Invalid msgpack
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusInvalidRequest, resp.Status)
	})
}

// TestHandleDeviceUnregister tests device unregistration
func TestHandleDeviceUnregister(t *testing.T) {
	logger := logging.DefaultLogger()
	deviceSvc := newMockDeviceService()
	deviceSvc.devices[1] = &entities.Device{ID: 1, Serial: "SN001"}
	handler := NewQUICServiceHandler(logger, WithQUICDeviceService(deviceSvc))

	ctx := context.Background()

	t.Run("successful unregistration", func(t *testing.T) {
		unregReq := &DeviceUnregisterRequest{ID: 1}

		payload, err := quic.EncodePayload(unregReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceUnregister,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusOK, resp.Status)

		var unregResp DeviceUnregisterResponse
		err = quic.DecodePayload(resp.Payload, &unregResp)
		require.NoError(t, err)
		assert.True(t, unregResp.Deleted)

		// Verify device was deleted
		_, exists := deviceSvc.devices[1]
		assert.False(t, exists)
	})

	t.Run("missing ID", func(t *testing.T) {
		unregReq := &DeviceUnregisterRequest{}

		payload, err := quic.EncodePayload(unregReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceUnregister,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusInvalidArgument, resp.Status)
	})

	t.Run("not found", func(t *testing.T) {
		unregReq := &DeviceUnregisterRequest{ID: 999}

		payload, err := quic.EncodePayload(unregReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceUnregister,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusNotFound, resp.Status)
	})
}

// TestHandleDeviceGet tests device retrieval
func TestHandleDeviceGet(t *testing.T) {
	logger := logging.DefaultLogger()
	deviceSvc := newMockDeviceService()
	deviceSvc.devices[1] = &entities.Device{
		ID:         1,
		Serial:     "SN001",
		Model:      "TestTPM",
		AttestPub:  "attestpub",
		SigningPub: "signingpub",
		EKCert:     "ekcert",
		HashAlgoId: 11,
	}
	handler := NewQUICServiceHandler(logger, WithQUICDeviceService(deviceSvc))

	ctx := context.Background()

	t.Run("get by ID", func(t *testing.T) {
		getReq := &DeviceGetRequest{ID: 1}

		payload, err := quic.EncodePayload(getReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceGet,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusOK, resp.Status)

		var getResp DeviceGetResponse
		err = quic.DecodePayload(resp.Payload, &getResp)
		require.NoError(t, err)
		assert.Equal(t, uint64(1), getResp.ID)
		assert.Equal(t, "SN001", getResp.Serial)
		assert.Equal(t, "TestTPM", getResp.Model)
		assert.Equal(t, "attestpub", getResp.AttestPub)
	})

	t.Run("get by serial", func(t *testing.T) {
		getReq := &DeviceGetRequest{Serial: "SN001"}

		payload, err := quic.EncodePayload(getReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceGet,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusOK, resp.Status)
	})

	t.Run("missing identifier", func(t *testing.T) {
		getReq := &DeviceGetRequest{}

		payload, err := quic.EncodePayload(getReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceGet,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusInvalidArgument, resp.Status)
	})

	t.Run("not found", func(t *testing.T) {
		getReq := &DeviceGetRequest{ID: 999}

		payload, err := quic.EncodePayload(getReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceGet,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusNotFound, resp.Status)
	})
}

// TestHandleDeviceList tests device listing
func TestHandleDeviceList(t *testing.T) {
	logger := logging.DefaultLogger()
	deviceSvc := newMockDeviceService()
	for i := uint64(1); i <= 5; i++ {
		deviceSvc.devices[i] = &entities.Device{ID: i, Serial: "SN", Model: "TPM"}
	}
	handler := NewQUICServiceHandler(logger, WithQUICDeviceService(deviceSvc))

	ctx := context.Background()

	t.Run("list all", func(t *testing.T) {
		listReq := &DeviceListRequest{PageSize: 10}

		payload, err := quic.EncodePayload(listReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceList,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusOK, resp.Status)

		var listResp DeviceListResponse
		err = quic.DecodePayload(resp.Payload, &listResp)
		require.NoError(t, err)
		assert.Len(t, listResp.Devices, 5)
		assert.Equal(t, 5, listResp.Total)
	})

	t.Run("list with empty payload", func(t *testing.T) {
		req := &quic.Request{
			Opcode:  quic.OpDeviceList,
			Payload: nil,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusOK, resp.Status)
	})

	t.Run("page error", func(t *testing.T) {
		errorDeviceSvc := newMockDeviceService()
		errorDeviceSvc.pageErr = errors.New("page failed")
		errorHandler := NewQUICServiceHandler(logger, WithQUICDeviceService(errorDeviceSvc))

		req := &quic.Request{
			Opcode:  quic.OpDeviceList,
			Payload: nil,
		}

		resp := errorHandler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusInternalError, resp.Status)
	})
}

// TestHandleDeviceUpdate tests device update
func TestHandleDeviceUpdate(t *testing.T) {
	logger := logging.DefaultLogger()
	deviceSvc := newMockDeviceService()
	deviceSvc.devices[1] = &entities.Device{ID: 1, Serial: "SN001", Model: "OldModel"}
	handler := NewQUICServiceHandler(logger, WithQUICDeviceService(deviceSvc))

	ctx := context.Background()

	t.Run("successful update", func(t *testing.T) {
		updateReq := &DeviceUpdateRequest{
			ID:     1,
			Serial: "SN001",
			Model:  "NewModel",
		}

		payload, err := quic.EncodePayload(updateReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceUpdate,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusOK, resp.Status)

		var updateResp DeviceUpdateResponse
		err = quic.DecodePayload(resp.Payload, &updateResp)
		require.NoError(t, err)
		assert.True(t, updateResp.Updated)
	})

	t.Run("missing ID", func(t *testing.T) {
		updateReq := &DeviceUpdateRequest{Model: "NewModel"}

		payload, err := quic.EncodePayload(updateReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceUpdate,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusInvalidArgument, resp.Status)
	})
}

// TestHandleDeviceGetMetrics tests metrics retrieval
func TestHandleDeviceGetMetrics(t *testing.T) {
	logger := logging.DefaultLogger()
	deviceSvc := newMockDeviceService()
	deviceSvc.devices[1] = &entities.Device{ID: 1}
	deviceSvc.devices[2] = &entities.Device{ID: 2}
	handler := NewQUICServiceHandler(logger, WithQUICDeviceService(deviceSvc))

	ctx := context.Background()

	t.Run("get metrics", func(t *testing.T) {
		req := &quic.Request{
			Opcode:  quic.OpDeviceGetMetrics,
			Payload: nil,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusOK, resp.Status)

		var metrics DeviceMetrics
		err := quic.DecodePayload(resp.Payload, &metrics)
		require.NoError(t, err)
		assert.Equal(t, 2, metrics.TotalDevices)
	})

	t.Run("count error", func(t *testing.T) {
		errorDeviceSvc := newMockDeviceService()
		errorDeviceSvc.countErr = errors.New("count failed")
		errorHandler := NewQUICServiceHandler(logger, WithQUICDeviceService(errorDeviceSvc))

		req := &quic.Request{
			Opcode:  quic.OpDeviceGetMetrics,
			Payload: nil,
		}

		resp := errorHandler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusInternalError, resp.Status)
	})
}

