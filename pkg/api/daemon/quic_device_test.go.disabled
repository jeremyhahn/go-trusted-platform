// TestHandleDeviceProfile tests profile operations
func TestHandleDeviceProfile(t *testing.T) {
	logger := logging.DefaultLogger()
	deviceSvc := newMockDeviceService()
	profileSvc := newMockProfileService()
	handler := NewQUICServiceHandler(logger,
		WithQUICDeviceService(deviceSvc),
		WithQUICDeviceProfileService(profileSvc),
	)

	ctx := context.Background()

	t.Run("get profile - service unavailable", func(t *testing.T) {
		noProfileHandler := NewQUICServiceHandler(logger, WithQUICDeviceService(deviceSvc))

		getReq := &DeviceGetProfileRequest{ID: 1}
		payload, err := quic.EncodePayload(getReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceGetProfile,
			Payload: payload,
		}

		resp := noProfileHandler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusUnavailable, resp.Status)
	})

	t.Run("create profile", func(t *testing.T) {
		createReq := &DeviceCreateProfileRequest{
			ID:    1,
			Name:  "TestProfile",
			Model: "TestModel",
			Role:  "server",
		}

		payload, err := quic.EncodePayload(createReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceCreateProfile,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusOK, resp.Status)

		var createResp DeviceCreateProfileResponse
		err = quic.DecodePayload(resp.Payload, &createResp)
		require.NoError(t, err)
		assert.True(t, createResp.Created)
		assert.Equal(t, "TestProfile", createResp.Name)
	})

	t.Run("create profile - missing ID", func(t *testing.T) {
		createReq := &DeviceCreateProfileRequest{
			Name: "TestProfile",
		}

		payload, err := quic.EncodePayload(createReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceCreateProfile,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusInvalidArgument, resp.Status)
	})

	t.Run("create profile - missing name", func(t *testing.T) {
		createReq := &DeviceCreateProfileRequest{
			ID: 2,
		}

		payload, err := quic.EncodePayload(createReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceCreateProfile,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusInvalidArgument, resp.Status)
	})

	t.Run("get profile", func(t *testing.T) {
		profileSvc.profiles[1] = &entities.DeviceProfile{
			ID:   1,
			Name: "TestProfile",
			Role: entities.DeviceRoleServer,
		}

		getReq := &DeviceGetProfileRequest{ID: 1}
		payload, err := quic.EncodePayload(getReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceGetProfile,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusOK, resp.Status)

		var profileResp DeviceProfileResponse
		err = quic.DecodePayload(resp.Payload, &profileResp)
		require.NoError(t, err)
		assert.Equal(t, "TestProfile", profileResp.Name)
	})

	t.Run("get profile - not found", func(t *testing.T) {
		getReq := &DeviceGetProfileRequest{ID: 999}
		payload, err := quic.EncodePayload(getReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceGetProfile,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusNotFound, resp.Status)
	})

	t.Run("list profiles", func(t *testing.T) {
		profileSvc.profiles[2] = &entities.DeviceProfile{ID: 2, Name: "Profile2", Role: entities.DeviceRoleClient}

		listReq := &DeviceListProfilesRequest{PageSize: 10}
		payload, err := quic.EncodePayload(listReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceListProfiles,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusOK, resp.Status)

		var listResp DeviceListProfilesResponse
		err = quic.DecodePayload(resp.Payload, &listResp)
		require.NoError(t, err)
		assert.GreaterOrEqual(t, len(listResp.Profiles), 1)
	})

	t.Run("delete profile", func(t *testing.T) {
		profileSvc.profiles[3] = &entities.DeviceProfile{ID: 3, Name: "ToDelete"}

		deleteReq := &DeviceDeleteProfileRequest{ID: 3}
		payload, err := quic.EncodePayload(deleteReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceDeleteProfile,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusOK, resp.Status)

		var deleteResp DeviceDeleteProfileResponse
		err = quic.DecodePayload(resp.Payload, &deleteResp)
		require.NoError(t, err)
		assert.True(t, deleteResp.Deleted)

		// Verify profile was deleted
		_, exists := profileSvc.profiles[3]
		assert.False(t, exists)
	})

	t.Run("delete profile - not found", func(t *testing.T) {
		deleteReq := &DeviceDeleteProfileRequest{ID: 999}
		payload, err := quic.EncodePayload(deleteReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceDeleteProfile,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusNotFound, resp.Status)
	})
}

// TestHandleDeviceSetProfile tests profile assignment
func TestHandleDeviceSetProfile(t *testing.T) {
	logger := logging.DefaultLogger()
	deviceSvc := newMockDeviceService()
	deviceSvc.devices[1] = &entities.Device{ID: 1}
	profileSvc := newMockProfileService()
	profileSvc.profiles[1] = &entities.DeviceProfile{ID: 1, Name: "TestProfile"}
	handler := NewQUICServiceHandler(logger,
		WithQUICDeviceService(deviceSvc),
		WithQUICDeviceProfileService(profileSvc),
	)

	ctx := context.Background()

	t.Run("set profile", func(t *testing.T) {
		setReq := &DeviceSetProfileRequest{
			DeviceID:  1,
			ProfileID: 1,
		}

		payload, err := quic.EncodePayload(setReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceSetProfile,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusOK, resp.Status)

		var setResp DeviceSetProfileResponse
		err = quic.DecodePayload(resp.Payload, &setResp)
		require.NoError(t, err)
		assert.True(t, setResp.Assigned)
	})

	t.Run("set profile - missing device ID", func(t *testing.T) {
		setReq := &DeviceSetProfileRequest{ProfileID: 1}

		payload, err := quic.EncodePayload(setReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceSetProfile,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusInvalidArgument, resp.Status)
	})

	t.Run("set profile - missing profile ID", func(t *testing.T) {
		setReq := &DeviceSetProfileRequest{DeviceID: 1}

		payload, err := quic.EncodePayload(setReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceSetProfile,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusInvalidArgument, resp.Status)
	})

	t.Run("set profile - device not found", func(t *testing.T) {
		setReq := &DeviceSetProfileRequest{
			DeviceID:  999,
			ProfileID: 1,
		}

		payload, err := quic.EncodePayload(setReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceSetProfile,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusNotFound, resp.Status)
	})

	t.Run("set profile - profile not found", func(t *testing.T) {
		setReq := &DeviceSetProfileRequest{
			DeviceID:  1,
			ProfileID: 999,
		}

		payload, err := quic.EncodePayload(setReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceSetProfile,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusNotFound, resp.Status)
	})
}

// TestHandleDeviceActivate tests device activation
func TestHandleDeviceActivate(t *testing.T) {
	logger := logging.DefaultLogger()
	deviceSvc := newMockDeviceService()
	deviceSvc.devices[1] = &entities.Device{
		ID:     1,
		Serial: "SN001",
		Model:  "TestModel",
	}
	profileSvc := newMockProfileService()
	profileSvc.profiles[1] = &entities.DeviceProfile{
		ID:   1,
		Name: "TestProfile",
		MatchRules: &entities.ProfileMatchRules{
			Model: "TestModel",
		},
		ProductionNetwork: &entities.NetworkPhaseConfig{
			VLAN: 100,
		},
	}
	handler := NewQUICServiceHandler(logger,
		WithQUICDeviceService(deviceSvc),
		WithQUICDeviceProfileService(profileSvc),
	)

	ctx := context.Background()

	t.Run("activate device", func(t *testing.T) {
		activateReq := &DeviceActivateRequest{
			ID:         1,
			MACAddress: "AA:BB:CC:DD:EE:FF",
		}

		payload, err := quic.EncodePayload(activateReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceActivate,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusOK, resp.Status)

		var activateResp DeviceActivateResponse
		err = quic.DecodePayload(resp.Payload, &activateResp)
		require.NoError(t, err)
		assert.Equal(t, "activated", activateResp.Status)
		assert.Equal(t, uint32(100), activateResp.VLAN)
	})

	t.Run("activate - missing identifier", func(t *testing.T) {
		activateReq := &DeviceActivateRequest{}

		payload, err := quic.EncodePayload(activateReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceActivate,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusInvalidArgument, resp.Status)
	})

	t.Run("activate - device not found", func(t *testing.T) {
		activateReq := &DeviceActivateRequest{ID: 999}

		payload, err := quic.EncodePayload(activateReq)
		require.NoError(t, err)

		req := &quic.Request{
			Opcode:  quic.OpDeviceActivate,
			Payload: payload,
		}

		resp := handler.HandleRequest(ctx, req)
		assert.Equal(t, quic.StatusNotFound, resp.Status)
	})
}

// TestProfileConversionHelpers tests profile conversion helper functions
func TestProfileConversionHelpers(t *testing.T) {
	logger := logging.DefaultLogger()
	handler := NewQUICServiceHandler(logger)

	t.Run("profileToQUICResponse with all fields", func(t *testing.T) {
		profile := &entities.DeviceProfile{
			ID:    1,
			Name:  "TestProfile",
			Model: "TestModel",
			Role:  entities.DeviceRoleServer,
			ProvisioningNetwork: &entities.NetworkPhaseConfig{
				VLAN:     10,
				StaticIP: "192.168.1.1",
				Gateway:  "192.168.1.254",
				DNS:      []string{"8.8.8.8", "8.8.4.4"},
			},
			ProductionNetwork: &entities.NetworkPhaseConfig{
				VLAN:   100,
				DHCP:   true,
				Subnet: "192.168.100.0/24",
			},
			QuarantineNetwork: &entities.NetworkPhaseConfig{
				VLAN:         200,
				FirewallZone: "quarantine",
			},
			PlatformdConfig: &entities.PlatformdConfigRef{
				ConfigType: "yaml",
				Reference:  "default",
				ConfigName: "platformd.yaml",
				ConfigPath: "/etc/platformd",
				Version:    "1.0.0",
			},
			MatchRules: &entities.ProfileMatchRules{
				MACPrefix:         "AA:BB:CC",
				SerialPrefix:      "SN",
				Model:             "TestModel",
				ModelPattern:      "Test*",
				SerialPattern:     "SN*",
				ManufacturerMatch: "TestMfg",
				TPMVendor:         "IBM",
				CustomAttributes: map[string]string{
					"env": "prod",
				},
			},
		}

		resp := handler.profileToQUICResponse(profile)
		assert.NotNil(t, resp)
		assert.Equal(t, uint64(1), resp.ID)
		assert.Equal(t, "TestProfile", resp.Name)
		assert.NotNil(t, resp.ProvisioningNetwork)
		assert.Equal(t, uint16(10), resp.ProvisioningNetwork.VLAN)
		assert.NotNil(t, resp.ProductionNetwork)
		assert.Equal(t, uint16(100), resp.ProductionNetwork.VLAN)
		assert.True(t, resp.ProductionNetwork.DHCP)
		assert.NotNil(t, resp.QuarantineNetwork)
		assert.Equal(t, uint16(200), resp.QuarantineNetwork.VLAN)
		assert.NotNil(t, resp.PlatformdConfig)
		assert.Equal(t, "yaml", resp.PlatformdConfig.ConfigType)
		assert.NotNil(t, resp.MatchRules)
		assert.Equal(t, "AA:BB:CC", resp.MatchRules.MACPrefix)
	})

	t.Run("quicRequestToProfile", func(t *testing.T) {
		createReq := &DeviceCreateProfileRequest{
			ID:    1,
			Name:  "NewProfile",
			Model: "NewModel",
			Role:  "server",
			ProvisioningNetwork: &NetworkPhaseConfigQUIC{
				VLAN:       10,
				StaticIP:   "10.0.0.1",
				AuthMethod: "802.1x",
			},
			MatchRules: &ProfileMatchRulesQUIC{
				MACPrefix: "00:11:22",
			},
		}

		profile := handler.quicRequestToProfile(createReq)
		assert.NotNil(t, profile)
		assert.Equal(t, uint64(1), profile.ID)
		assert.Equal(t, "NewProfile", profile.Name)
		assert.Equal(t, entities.DeviceRole("server"), profile.Role)
		assert.NotNil(t, profile.ProvisioningNetwork)
		assert.Equal(t, uint16(10), profile.ProvisioningNetwork.VLAN)
		assert.NotNil(t, profile.MatchRules)
		assert.Equal(t, "00:11:22", profile.MatchRules.MACPrefix)
	})
}

// TestSetServiceMethods tests the setter methods for services
func TestSetServiceMethods(t *testing.T) {
	logger := logging.DefaultLogger()
	handler := NewQUICServiceHandler(logger)

	deviceSvc := newMockDeviceService()
	profileSvc := newMockProfileService()

	handler.SetDeviceService(deviceSvc)
	handler.SetDeviceProfileService(profileSvc)

	assert.Equal(t, deviceSvc, handler.deviceService)
	assert.Equal(t, profileSvc, handler.profileService)
}

// TestUnknownDeviceOpcode tests handling of unknown device opcodes
func TestUnknownDeviceOpcode(t *testing.T) {
	logger := logging.DefaultLogger()
	deviceSvc := newMockDeviceService()
	handler := NewQUICServiceHandler(logger, WithQUICDeviceService(deviceSvc))

	ctx := context.Background()

	// Use a device opcode that's not implemented (0x3F is reserved)
	req := &quic.Request{
		Opcode:  0x3F,
		Payload: nil,
	}

	resp := handler.HandleRequest(ctx, req)
	assert.Equal(t, quic.StatusNotImplemented, resp.Status)
}
