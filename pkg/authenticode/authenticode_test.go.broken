func TestExtractCertificateFromPKCS7Errors(t *testing.T) {
	_, cert := generateTestKey(t)
	s := &Signer{cert: cert}

	tests := []struct {
		name    string
		data    []byte
		errMsg  string
	}{
		{
			name:   "invalid asn1 - contentInfo",
			data:   []byte{0x30, 0x05, 0x01, 0x02, 0x03},
			errMsg: "failed to parse ContentInfo",
		},
		{
			name: "no certificates in pkcs7",
			data: func() []byte {
				// Create a minimal PKCS#7 SignedData with no certificates
				emptySignedData, _ := asn1.Marshal(signedData{
					Version:      1,
					Certificates: asn1.RawValue{Bytes: []byte{}},
				})
				ci := contentInfo{
					ContentType: oidSignedData,
					Content: asn1.RawValue{
						Class:      asn1.ClassContextSpecific,
						Tag:        0,
						IsCompound: true,
						Bytes:      emptySignedData,
					},
				}
				data, _ := asn1.Marshal(ci)
				return data
			}(),
			errMsg: "no certificates in PKCS#7",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			_, err := s.extractCertificateFromPKCS7(tt.data)
			require.Error(t, err)
			require.Contains(t, err.Error(), tt.errMsg)
		})
	}
}

func TestSigningTime(t *testing.T) {
	key, cert := generateTestKey(t)
	logger := logging.DefaultLogger()

	signer, err := NewSigner(&SignerOptions{
		KeyStore:      &mockBackend{privateKey: key, cert: cert},
		KeyAttributes: &types.KeyAttributes{CN: "test"},
		Certificate:   cert,
		Logger:        logger,
	})
	require.NoError(t, err)

	// Create and sign a PE file
	beforeSign := time.Now().UTC()
	peData := createMinimalPE(t)
	input := bytes.NewReader(peData)
	output := &bytes.Buffer{}

	err = signer.Sign(input, output)
	require.NoError(t, err)
	afterSign := time.Now().UTC()

	// Extract signing time
	signedData := output.Bytes()
	extractInput := bytes.NewReader(signedData)

	signingTime, err := SigningTime(extractInput)
	require.NoError(t, err)

	// Signing time should be between before and after
	require.True(t, signingTime.After(beforeSign.Add(-time.Second)))
	require.True(t, signingTime.Before(afterSign.Add(time.Second)))
}

func TestSigningTimeUnsigned(t *testing.T) {
	// Try to get signing time from unsigned PE - should fail
	peData := createMinimalPE(t)
	input := bytes.NewReader(peData)

	signingTime, err := SigningTime(input)
	require.Error(t, err)
	require.True(t, signingTime.IsZero())
	require.Contains(t, err.Error(), "not signed")
}

