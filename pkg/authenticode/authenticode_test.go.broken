func TestVerifyPKCS7SignatureErrors(t *testing.T) {
	_, cert := generateTestKey(t)
	s := &Signer{cert: cert}

	peData := createMinimalPE(t)
	pe, err := parsePE(peData)
	require.NoError(t, err)

	tests := []struct {
		name    string
		data    []byte
		errMsg  string
	}{
		{
			name:   "invalid contentInfo",
			data:   []byte{0x30, 0x02, 0x01, 0x00},
			errMsg: "failed to parse ContentInfo",
		},
		{
			name: "trailing data after contentInfo",
			data: func() []byte {
				ci := contentInfo{
					ContentType: oidSignedData,
					Content:     asn1.RawValue{Bytes: []byte{}},
				}
				data, _ := asn1.Marshal(ci)
				return append(data, 0xFF, 0xFF)
			}(),
			errMsg: "trailing data after ContentInfo",
		},
		{
			name: "unexpected content type",
			data: func() []byte {
				ci := contentInfo{
					ContentType: asn1.ObjectIdentifier{1, 2, 3, 4, 5},
					Content:     asn1.RawValue{Bytes: []byte{}},
				}
				data, _ := asn1.Marshal(ci)
				return data
			}(),
			errMsg: "unexpected content type",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			err := s.verifyPKCS7Signature(pe, tt.data)
			require.Error(t, err)
			require.Contains(t, err.Error(), tt.errMsg)
		})
	}
}

