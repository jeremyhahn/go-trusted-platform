# Platform API Environment Configuration
# This file should be copied to /etc/trusted-platform/platform-api.env
# and customized for your environment.

# Listen address (default: 0.0.0.0 - all interfaces)
PLATFORM_API_HOST=0.0.0.0

# Listen port (default: 8443)
PLATFORM_API_PORT=8443

# Path to platformd Unix socket
# The platform user must have permission to access this socket
PLATFORM_API_SOCKET=/run/platformd/platformd.sock

# TLS Configuration
# Path to server certificate (PEM format)
PLATFORM_API_TLS_CERT=/etc/trusted-platform/certs/api-server.crt

# Path to server private key (PEM format)
PLATFORM_API_TLS_KEY=/etc/trusted-platform/certs/api-server.key

# Path to CA certificate for client verification (mTLS)
PLATFORM_API_TLS_CA=/etc/trusted-platform/certs/ca.crt

# Enable mutual TLS (require client certificates)
# Set to "true" to enable, "false" to disable
PLATFORM_API_MTLS=false

# Debug mode
# Set to "--debug" to enable debug logging, leave empty for production
PLATFORM_API_DEBUG=

# CORS support
# Set to "true" to enable CORS, "false" to disable (default)
PLATFORM_API_CORS=false

# API base path (default: /api/v1)
PLATFORM_API_BASE_PATH=/api/v1

# Log HTTP requests (default: true)
PLATFORM_API_LOG_REQUESTS=true
