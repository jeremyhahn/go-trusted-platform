# /lib/systemd/system/platform-api.service
[Unit]
Description=Trusted Platform :: REST API Gateway
Documentation=https://letstrust.org/docs/api
After=network.target platformd.service
Wants=network.target
Requires=platformd.service

[Service]
Type=simple
User=platform
Group=platform
Restart=always
RestartSec=5s
WorkingDirectory=/var/lib/trusted-platform

# Environment file for runtime configuration (set during install)
EnvironmentFile=-/etc/trusted-platform/platform-api.env

# ExecStart uses environment variables for configuration
# Variables will be set based on install options:
#   PLATFORM_API_HOST - Listen address (default: 0.0.0.0)
#   PLATFORM_API_PORT - Listen port (default: 8443)
#   PLATFORM_API_SOCKET - Path to platformd socket (default: /run/platformd/platformd.sock)
#   PLATFORM_API_TLS_CERT - TLS certificate file
#   PLATFORM_API_TLS_KEY - TLS key file
#   PLATFORM_API_TLS_CA - CA certificate for mTLS
#   PLATFORM_API_MTLS - Enable mTLS (true/false)
#   PLATFORM_API_DEBUG - Enable debug mode (--debug flag or empty)
ExecStart=/usr/sbin/platform-api \
    --host=${PLATFORM_API_HOST:-0.0.0.0} \
    --port=${PLATFORM_API_PORT:-8443} \
    --socket=${PLATFORM_API_SOCKET:-/run/platformd/platformd.sock} \
    --tls-cert=${PLATFORM_API_TLS_CERT:-/etc/trusted-platform/certs/api-server.crt} \
    --tls-key=${PLATFORM_API_TLS_KEY:-/etc/trusted-platform/certs/api-server.key} \
    --tls-ca=${PLATFORM_API_TLS_CA:-/etc/trusted-platform/certs/ca.crt} \
    --mtls=${PLATFORM_API_MTLS:-false} \
    --log-dir=/var/log/trusted-platform \
    ${PLATFORM_API_DEBUG}

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

# Read access
ReadOnlyPaths=/etc/trusted-platform
ReadOnlyPaths=/var/lib/trusted-platform

# Write access (logs only)
ReadWritePaths=/var/log/trusted-platform

# Socket access (must be able to connect to platformd socket)
# The platform user must be a member of the platformd group
ReadWritePaths=/run/platformd

# Restrict access to sensitive directories
InaccessiblePaths=/root
InaccessiblePaths=/boot
InaccessiblePaths=/home

# Network restrictions (HTTPS only)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# System call filtering
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount
SystemCallErrorNumber=EPERM

# Capability restrictions (none needed for unprivileged API server)
CapabilityBoundingSet=
AmbientCapabilities=

# Process properties
UMask=0027

[Install]
WantedBy=multi-user.target
