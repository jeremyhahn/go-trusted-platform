# Kernel options every platform kernel must carry: the overlay datapath,
# IPsec, conntrack/NAT, VRFs, vsock and the hardening posture
# (docs/sdn/engineering.md, "IPsec" > "Kernel configuration").
#
# One list for every kernel the platform builds. The fips kernel
# (build/docker/fips-kernel-builder, x86_64) and the virt kernel
# (build/docker/virt-kernel-builder, arm64) merge it on top of their
# defconfig with scripts/kconfig/merge_config.sh, then require-config.sh
# fails the build if `make olddefconfig` dropped or changed any line: an
# unmet dependency is a build failure, never a silent downgrade. The same
# list, in --enabled mode, verifies the Alpine kernels the platform ships
# but does not build (make kernel-config-check-alpine).
#
# Only symbols on the required list and the dependencies Kconfig would
# otherwise resolve against them are here; each dependency says why.
# Kconfig fragments take no trailing comments, so every note is a line of
# its own.

# --- Overlay datapath ------------------------------------------------------
# NF_CT_PROTO_SCTP depends on NETFILTER_ADVANCED.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_OPENVSWITCH=m
CONFIG_OPENVSWITCH_VXLAN=m
CONFIG_VXLAN=m

# --- IPsec (host-to-host ESP transport SAs driven by charon over XFRM) -----
# INET6_ESP depends on IPV6.
CONFIG_IPV6=y
CONFIG_XFRM_USER=m
CONFIG_INET_ESP=m
CONFIG_INET6_ESP=m
CONFIG_CRYPTO_GCM=y

# --- Conntrack and NAT -------------------------------------------------------
# OPENVSWITCH depends on (!NF_NAT || NF_NAT): as a module it needs NF_NAT no
# stronger than itself, so conntrack and NAT are modules alongside it.
# NF_NAT_OVS is not user-selectable: OPENVSWITCH selects it when NF_NAT is
# enabled, and requiring it here proves that happened.
# SCTP NAT has no symbol of its own: nf_nat_proto.c rewrites SCTP ports and
# checksums under CONFIG_NF_CT_PROTO_SCTP, so SCTP conntrack is SCTP NAT.
CONFIG_NF_CONNTRACK=m
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_CT_PROTO_SCTP=y
CONFIG_NF_NAT=m
CONFIG_NF_NAT_OVS=y

# --- Tenancy -----------------------------------------------------------------
# NET_VRF depends on IP_MULTIPLE_TABLES (itself behind IP_ADVANCED_ROUTER),
# IPV6_MULTIPLE_TABLES and NET_L3_MASTER_DEV; the arm64 defconfig has none of
# them, and Kconfig dropped NET_VRF there until they were listed.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NET_L3_MASTER_DEV=y
CONFIG_NET_VRF=m

# --- vsock (host <-> guest control channel) --------------------------------
CONFIG_VSOCKETS=m
CONFIG_VIRTIO_VSOCKETS=m
CONFIG_VHOST_VSOCK=m

# --- Hardening ---------------------------------------------------------------
# MODULE_SIG_FORCE depends on MODULE_SIG; SECURITY_LOCKDOWN_LSM and
# INTEGRITY depend on SECURITY; IMA_APPRAISE depends on IMA, which depends on
# INTEGRITY. Built in is not switched on: IMA appraisal still needs a policy
# (ima_appraise= / ima_policy=) and lockdown a mode (lockdown=).
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_INTEGRITY=y
CONFIG_IMA=y
CONFIG_IMA_APPRAISE=y
# SCHED_CORE depends on SCHED_SMT (user-selectable on arm64, def_bool on x86).
CONFIG_SCHED_SMT=y
CONFIG_SCHED_CORE=y
# CRYPTO_FIPS depends on (CRYPTO_ANSI_CPRNG || CRYPTO_DRBG),
# !CRYPTO_MANAGER_DISABLE_TESTS (default y) and (MODULE_SIG || !MODULES).
# The FIPS DRBG is required with all three of its SP 800-90A mechanisms.
# CONFIG_CRYPTO_MANAGER_DISABLE_TESTS is not set
CONFIG_CRYPTO_DRBG_MENU=y
CONFIG_CRYPTO_DRBG_HMAC=y
CONFIG_CRYPTO_DRBG_HASH=y
CONFIG_CRYPTO_DRBG_CTR=y
CONFIG_CRYPTO_DRBG=y
CONFIG_CRYPTO_FIPS=y
