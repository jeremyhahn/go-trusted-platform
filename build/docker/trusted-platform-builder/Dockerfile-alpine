ARG BASE_IMAGE=golang:alpine

FROM $BASE_IMAGE

LABEL maintainer="Jeremy Hahn <mail@jeremyhahn.com>"

ARG SRC_DIR=.
ARG BUILD_DIR=/builder
ARG ENTRY_POINT=build/docker/trusted-platform-builder/entrypoint.sh
ARG OPENSSL_VERSION=openssl-3.4.1
ARG WITH_WEB=false

# Fixes hanging ARM64 builds using aarch64-binfmt-P
ENV GOMAXPROCS=1

WORKDIR $BUILD_DIR

RUN apk update && \
    apk upgrade && \
    apk add --no-cache \
        autoconf \
        automake \
        build-base \
        openssl-dev \
        py3-cryptography \
        gnutls-dev \
        linux-headers \
        musl-dev \
        pkgconf \
        curl \
        git \
        make \
        tpm2-tools \
        opensc \
        yubikey-manager \
        ipmitool \
        nodejs \
        npm \
        openssl-libs-static

RUN npm install --global yarn

RUN go version

# ARG LIBVIRT_VERSION=11.0.0
# RUN wget "https://download.libvirt.org/libvirt-${LIBVIRT_VERSION}.tar.xz" -O libvirt.tar.xz && \
#     tar xf libvirt.tar.xz && \
#     cd libvirt-${LIBVIRT_VERSION} && \
#     meson setup build \
#         -Dsystem=true \
#         -Ddriver_qemu=enabled \
#         -Dapparmor=disabled \
#         -Ddefault_library=static \
#         -Dlibnl=enabled && \
#     ninja -C build install
# ENV CGO_LDFLAGS="-static -L/usr/local/openssl/lib -L/usr/local/openssl/lib64 -L/usr/local/lib"

COPY $SRC_DIR go-trusted-platform

# Build the web frontend
# Copy SDK first so web's package.json can resolve "file:../sdk/javascript"
COPY sdk /builder/sdk
RUN cd /builder/sdk/javascript && \
    npm install && \
    npm run build
COPY web /builder/web
RUN cd /builder/web && \
    yarn install && \
    yarn build

# If WITH_WEB=true, copy to embed location and build with platform_web tag
# If WITH_WEB=false, copy built output to /var/www/html for nginx/file serving
RUN if [ "$WITH_WEB" = "true" ]; then \
        mkdir -p /builder/go-trusted-platform/pkg/webserver/embed/dist && \
        cp -r /builder/web/out/* /builder/go-trusted-platform/pkg/webserver/embed/dist/; \
    else \
        mkdir -p /var/www/html && \
        cp -r /builder/web/out/* /var/www/html/; \
    fi

# Note: We don't build go-trusted-platform here because:
# 1. The go.mod has replace directives pointing to host paths not available in Docker build
# 2. Integration tests mount the source code at runtime and build/test there
# 3. The Docker image is used as a build environment with necessary tools
# If pre-built binaries are needed, build on host or use multi-stage build with all modules copied

COPY $ENTRY_POINT /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
CMD $ENTRY_POINT
