# go-trusted-platform-web (dashboard)
RUN git clone https://github.com/jeremyhahn/go-trusted-platform-web.git && \
    cd go-trusted-platform-web && \
    yarn install && \
    yarn build

COPY $SRC_DIR go-trusted-platform

# Fixes hanging ARM64 builds using aarch64-binfmt-P
ENV GOMAXPROCS=1

# Build go-trusted-platform (platform software)
RUN cd go-trusted-platform && \
    go install github.com/swaggo/swag/cmd/swag@latest && \
    make build-public-html

RUN cd go-trusted-platform && \
    make build build-debug

RUN cd go-trusted-platform && \
    CGO_LDFLAGS="-static -L/usr/local/openssl/lib -L/usr/local/openssl/lib64 -L/usr/local/lib" \
    make build-static build-debug-static

COPY $ENTRY_POINT /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
CMD $ENTRY_POINT
