# arm64 Alpine with swtpm for the factory-image userspace suite (make integration-test-diskimage-userspace).
FROM alpine:3.22

RUN apk add --no-cache \
        bash \
        ca-certificates \
        cryptsetup \
        dosfstools \
        lvm2 \
        swtpm \
        tpm2-tools \
        util-linux

RUN mkdir -p /trusted-platform/volume/swtpm

WORKDIR /trusted-platform
