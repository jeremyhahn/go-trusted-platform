ARG BASE_IMAGE="debian:bookworm"

FROM $BASE_IMAGE

ARG BUILDER_IMAGE="trusted-platform-builder"
ARG MOUNT_POINT="/trusted-platform"

LABEL maintainer="Jeremy Hahn <mail@jeremyhahn.com>"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y \
        sudo \
        bash \
        procps \
        tpm2-tools \
        opensc \
        libsofthsm2 \
        softhsm2 \
        swtpm \
        libtpms0 \
        swtpm \
        tpm2-tools \
        tpm2-abrmd \
        libtss2-tcti-swtpm0 \
        libssl-dev \
        libtpm2-pkcs11-1 \
        yubikey-manager \
        libu2f-udev \
        ca-certificates && \
    rm -rf /var/cache/apt/*

RUN addgroup --gid 1000 tpadm && \
    useradd -u 1000 -g tpadm -ms /bin/bash tpadm && \
    echo "tpadm ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

RUN mkdir $MOUNT_POINT && \
    chmod 777 $MOUNT_POINT && \
    chown -R tpadm:tpadm $MOUNT_POINT

COPY platformd /usr/local/bin/platformd
RUN chmod +x /usr/local/bin/platformd
RUN chown tpadm:tpadm /usr/local/bin/platformd

WORKDIR $MOUNT_POINT

USER tpadm

COPY --chown=root:root --chmod=755 entrypoint-swtpm.sh /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
