[Unit]
Description=Trusted Platform Container (Podman)
After=network.target

[Service]
ExecStart=/usr/bin/podman run --rm -d \
  --name {{ trusted_platform_container_name }} \
  {% for port in trusted_platform_ports %}
  -p {{ port }} \
  {% endfor %}
  {% for volume in trusted_platform_volumes %}
  -v {{ volume }} \
  {% endfor %}
  {{ trusted_platform_extra_args }} \
  {{ trusted_platform_image }}

ExecStop=/usr/bin/podman stop {{ trusted_platform_container_name }}
Restart=always
User={{ trusted_platform_user }}
Group={{ trusted_platform_user }}

[Install]
WantedBy=multi-user.target
