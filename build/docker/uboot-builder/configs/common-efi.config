# Trusted Platform U-Boot: options common to every board.
#
# TPM 2.0 with the tpm2 command, EFI_TCG2_PROTOCOL measured boot (PCR 0
# S-CRTM version, 1 boot variables, 2 drivers, 4 the loaded EFI application,
# 5 ExitBootServices, 7 Secure Boot variables), EFI Secure Boot verified
# against the preseeded PK/KEK/db, a FAT-backed variable store on the ESP
# and the boot manager that finds EFI/BOOT/BOOTAA64.EFI.
#
# EFI_TCG2_PROTOCOL_MEASURE_DTB stays off on purpose: U-Boot rewrites
# /chosen/kaslr-seed on every boot, so a measured DTB would never repeat and
# no PCR policy sealed against it could unseal.
CONFIG_TPM=y
CONFIG_TPM_V2=y
CONFIG_TPM_PCR_ALLOCATE=y
CONFIG_CMD_TPM=y
CONFIG_HASH=y
CONFIG_SHA1=y
CONFIG_SHA256=y
CONFIG_SHA384=y
CONFIG_SHA512=y
CONFIG_EFI_LOADER=y
CONFIG_EFI_TCG2_PROTOCOL=y
CONFIG_FIT=y
CONFIG_FIT_SIGNATURE=y
CONFIG_RSA=y
CONFIG_RSA_VERIFY=y
CONFIG_EFI_SECURE_BOOT=y
CONFIG_FAT_WRITE=y
CONFIG_EFI_VARIABLE_FILE_STORE=y
CONFIG_EFI_VARIABLES_PRESEED=y
CONFIG_EFI_VAR_SEED_FILE="ubootefi.var"
CONFIG_CMD_BOOTEFI=y
CONFIG_CMD_BOOTEFI_BOOTMGR=y
CONFIG_BOOTSTD_DEFAULTS=y
CONFIG_CMD_EFIDEBUG=y
CONFIG_CMD_NVEDIT_EFI=y
CONFIG_BOOTDELAY=1
# Network boot: U-Boot's standard boot flow tries the network after the
# disks (BOOTDEV_ETH + BOOTMETH_EFILOADER: DHCP, TFTP the offered bootfile,
# run it as an EFI application under the same Secure Boot verification as
# a disk-booted UKI). The DHCP request identifies the client as a standard
# EFI AArch64 PXE client (RFC 4578 option 93 = 0x0b) so any PXE server's
# per-architecture bootfile map — the platform's serves its signed arm64
# iPXE — picks the right binary. The vendor class stays U-Boot's own
# ("U-Boot.armv8", a non-visible symbol); the platform's DHCP server
# recognises it as well. The legacy network stack is required: lwIP's DHCP
# client sends neither option 60 nor option 93.
# CONFIG_NET_LWIP is not set
CONFIG_NET=y
CONFIG_NET_LEGACY=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PXE=y
CONFIG_BOOTP_PXE=y
CONFIG_BOOTP_PXE_DHCP_OPTION=y
CONFIG_DHCP_PXE_CLIENTARCH=0xb
CONFIG_BOOTDEV_ETH=y
CONFIG_BOOTMETH_EFILOADER=y
