# Raspberry Pi 3B+/4B/CM4/400 (rpi_arm64_defconfig): the Infineon SLB9670 on
# SPI0 CE1 (the LetsTrust / Iridium 9670 add-on wiring). Mainline U-Boot
# has no BCM2835 SPI controller driver, so the bus is bit-banged over GPIO
# by SOFT_SPI; tpm-soft-spi.dts describes it and the Linux kernel drives the
# same node with spi-gpio.
CONFIG_SPI=y
CONFIG_DM_SPI=y
CONFIG_SOFT_SPI=y
CONFIG_TPM2_TIS_SPI=y
