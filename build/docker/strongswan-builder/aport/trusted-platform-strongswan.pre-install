#!/bin/sh
# charon starts as root to open the IKE sockets and the kernel IPsec
# interface, then switches to this user (the package is built with
# --with-user/--with-group), keeping only the capabilities it needs.
addgroup -S strongswan 2>/dev/null
adduser -S -D -H -h /var/empty -s /sbin/nologin -G strongswan -g strongswan strongswan 2>/dev/null
exit 0
