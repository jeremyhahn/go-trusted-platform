#!/sbin/openrc-run
# strongSwan charon, the IKEv2 daemon of the Trusted Platform overlay.
#
# supervise-daemon restarts charon if it dies. charon starts as root, binds
# the IKE ports and opens the kernel IPsec interface, then switches to the
# strongswan user keeping only the capabilities its plugins ask for --
# CAP_NET_ADMIN, for kernel-netlink (the package is built
# --with-user=strongswan --with-group=strongswan --with-capabilities=libcap).
# charon writes its own /run/charon.pid, so this script does not give it one.
#
# The VICI socket (/run/charon.vici, set in strongswan.d/trusted-platform.conf)
# is the control plane: whoever can connect to it can load credentials and
# bring tunnels up or down. charon hands it to its own user at mode 0660; this
# script gives it to the platform user at mode 0600, once charon is serving it
# and again whenever the health check finds charon has recreated it.
#
# The IKE key lives behind PKCS#11 in the module host, so charon starts only
# after it (xkms-p11-kit, from trusted-platform-p11-host).

description="strongSwan charon IKEv2 daemon"
supervisor="supervise-daemon"
command="/usr/lib/strongswan/charon"
command_args="${CHARON_OPTS}"
respawn_delay="${CHARON_RESPAWN_DELAY:-2}"
respawn_max="${CHARON_RESPAWN_MAX:-10}"
respawn_period="${CHARON_RESPAWN_PERIOD:-60}"
healthcheck_timer="${CHARON_HEALTHCHECK_INTERVAL:-30}"
extra_started_commands="reload"
description_reload="Reload strongswan.conf and the swanctl configuration"

vici_socket="/run/charon.vici"
charon_user="strongswan"
vici_user="${CHARON_VICI_USER:-platformd}"
vici_group="${CHARON_VICI_GROUP:-platform}"

depend() {
	need net xkms-p11-kit
	after firewall
	provide ipsec
}

# own_vici_socket gives the VICI socket to the platform user, mode 0600.
own_vici_socket() {
	chown "${vici_user}:${vici_group}" "${vici_socket}" && chmod 0600 "${vici_socket}"
}

start_pre() {
	if ! id "${vici_user}" >/dev/null 2>&1 || ! grep -q "^${vici_group}:" /etc/group; then
		eerror "VICI socket owner ${vici_user}:${vici_group} does not exist (CHARON_VICI_USER, CHARON_VICI_GROUP in /etc/conf.d/${RC_SVCNAME})"
		return 1
	fi
	# A socket left by a charon that died must not look like a live one.
	rm -f "${vici_socket}"
}

# start_post waits for charon to serve the socket as its own user -- the sign
# that it has finished with the socket and dropped root -- then takes it over.
start_post() {
	local tries=0
	while [ "$(stat -c %U "${vici_socket}" 2>/dev/null)" != "${charon_user}" ]; do
		tries=$((tries + 1))
		if [ "${tries}" -gt 100 ]; then
			eerror "charon did not create ${vici_socket}"
			return 1
		fi
		sleep 0.1
	done
	own_vici_socket
}

# healthcheck runs every CHARON_HEALTHCHECK_INTERVAL seconds under
# supervise-daemon. It restores the socket's owner after a respawn and asks
# charon for its statistics, which fails if it no longer answers VICI.
healthcheck() {
	own_vici_socket && /usr/sbin/swanctl --stats >/dev/null
}

reload() {
	ebegin "Reloading ${RC_SVCNAME}"
	/usr/sbin/swanctl --reload-settings
	eend $?
}
