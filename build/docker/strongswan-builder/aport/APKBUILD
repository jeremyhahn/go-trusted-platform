# Trusted Platform strongSwan: charon (IKEv2 only) and swanctl, with OpenSSL
# as the only crypto provider and PKCS#11 for keys held outside the daemon.
#
# Built by build/docker/strongswan-builder (see its README.md). The source
# tarball reaching abuild has already been verified against the pinned
# strongSwan release signing key and the pinned SHA-256; the sha512sums below
# are generated by `abuild checksum` from that verified file.
#
# pkgver and _plugins are templated from the builder Makefile
# (STRONGSWAN_VERSION, STRONGSWAN_PLUGINS) so the pins live in one place.
pkgname=trusted-platform-strongswan
pkgver=@STRONGSWAN_VERSION@
pkgrel=0
pkgdesc="strongSwan charon IKEv2 daemon for the Trusted Platform overlay (openssl, pkcs11, vici, swanctl)"
url="https://www.strongswan.org/"
arch="x86_64 aarch64"
license="GPL-2.0-or-later WITH OpenSSL-Exception"
# Alpine's own strongswan package installs the same files. p11-kit-server
# carries p11-kit-client.so, the PKCS#11 module charon loads. It must be 0.26 or
# newer: a 0.26 client against an older p11-kit server silently corrupts
# byte-array attributes (CKA_ID 01 arrives as 01000000), and the module host
# (trusted-platform-p11-host) runs a 0.26 server.
depends="!strongswan p11-kit-server>=0.26"
makedepends="libcap-dev linux-headers openssl-dev>3"
# The libstrongswan time-format test formats in Europe/Zurich.
checkdepends="tzdata"
pkgusers="strongswan"
pkggroups="strongswan"
install="$pkgname.pre-install"
subpackages="$pkgname-doc $pkgname-openrc"
source="https://download.strongswan.org/strongswan-$pkgver.tar.bz2
	charon.initd
	charon.confd
	socket-takeover
	trusted-platform.conf
	pkcs11.conf
	"
builddir="$srcdir/strongswan-$pkgver"

# Every plugin charon may load. --disable-defaults turns the rest off, so the
# package carries exactly these and package() refuses to finish otherwise.
#   openssl, pkcs11, vici      the crypto provider, external keys, the control API
#   counters                   IKE statistics; configure turns it on with vici
#   nonce                      IKE nonces (from the openssl RNG)
#   kernel-netlink             the kernel IPsec (XFRM) and routing interface
#   socket-default             the IKE UDP sockets
#   pem                        PEM decoding of certificates, CRLs and keys
#   revocation, constraints    CRL checking and X.509 name/path constraints
#   updown                     the per-CHILD_SA script hook
_plugins="@STRONGSWAN_PLUGINS@"

build() {
	local _enable= _p
	for _p in $_plugins; do
		_enable="$_enable --enable-$_p"
	done

	# --disable-defaults: no in-tree crypto (aes, sha*, gmp, curve25519, ...),
	# no EAP, XAuth or legacy stroke. --disable-ikev1: IKEv2 only.
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--sysconfdir=/etc \
		--libexecdir=/usr/lib \
		--with-ipsecdir=/usr/lib/strongswan \
		--with-capabilities=libcap \
		--with-user=strongswan \
		--with-group=strongswan \
		--disable-defaults \
		--enable-charon \
		--enable-swanctl \
		--enable-ikev2 \
		--disable-ikev1 \
		--disable-static \
		--enable-shared \
		$_enable
	make
}

check() {
	make check
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm755 "$srcdir"/charon.initd "$pkgdir"/etc/init.d/charon
	install -Dm644 "$srcdir"/charon.confd "$pkgdir"/etc/conf.d/charon
	install -Dm755 "$srcdir"/socket-takeover "$pkgdir"/usr/lib/strongswan/socket-takeover
	install -Dm644 "$srcdir"/trusted-platform.conf "$pkgdir"/etc/strongswan.d/trusted-platform.conf
	install -Dm644 "$srcdir"/pkcs11.conf "$pkgdir"/etc/strongswan.d/charon/pkcs11.conf

	# The installed plugin set must be exactly _plugins: a configure default
	# that changes between releases must fail the build, not ship silently.
	local _want _got
	_want=$(for p in $_plugins; do echo "libstrongswan-$p.so"; done | sort)
	_got=$(find "$pkgdir" -path '*/plugins/libstrongswan-*.so' -exec basename {} \; | sort)
	if [ "$_want" != "$_got" ]; then
		error "installed plugins differ from the pinned set"
		echo "want:" $_want >&2
		echo "got: " $_got >&2
		return 1
	fi
}
