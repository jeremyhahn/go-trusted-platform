# Configuration for /etc/init.d/charon.
#
# Extra arguments for charon (it has few; settings belong in
# /etc/strongswan.conf and /etc/strongswan.d/).
#CHARON_OPTS=""

# supervise-daemon restart policy, and how often (seconds) the service checks
# that charon still answers VICI.
#CHARON_RESPAWN_DELAY=2
#CHARON_RESPAWN_MAX=10
#CHARON_RESPAWN_PERIOD=60
#CHARON_HEALTHCHECK_INTERVAL=30

# How long (tenths of a second) each start waits for charon to serve the VICI
# socket before it is given to the owner below. A charon that has not served
# it by then is stopped and respawned.
#CHARON_TAKEOVER_TRIES=100

# The owner of the VICI socket (/run/charon.vici, mode 0600): the account the
# platform daemon runs as, root on the nodes the installer builds. Change it
# only together with the account platformd runs as: platformd refuses a socket
# its own uid does not own. The service refuses to start if it does not exist.
#CHARON_VICI_USER="root"
#CHARON_VICI_GROUP="root"

# charon reaches the IKE key through p11-kit-client.so (the pkcs11 plugin is
# configured in /etc/strongswan.d/charon/pkcs11.conf), which talks to the
# p11-kit server of the module host (/etc/init.d/xkms-p11-kit) on this socket.
export P11_KIT_SERVER_ADDRESS="unix:path=/run/p11-kit/xkms.sock"
