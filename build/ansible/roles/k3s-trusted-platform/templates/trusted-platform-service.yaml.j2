apiVersion: v1
kind: Service
metadata:
  name: trusted-platform-service
  namespace: {{ k3s_namespace }}
spec:
  selector:
    app: trusted-platform
  ports:
    - name: http
      protocol: TCP
      port: {{ trusted_platform_http_port }}
      targetPort: {{ trusted_platform_http_port }}
    - name: https
      protocol: TCP
      port: {{ trusted_platform_https_port }}
      targetPort: {{ trusted_platform_https_port }}
  type: ClusterIP
